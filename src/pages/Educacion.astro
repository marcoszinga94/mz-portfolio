---
import Layout from "../layouts/Layout.astro";
const EDUCACION = [
  {
    fecha: "...Actualidad",
    titulo: "Desarrollador Web Full-Stack Independiente",
    descripcion:
      "Comprometido a la mejora continua a través de proyectos independientes, me esfuerzo diariamente para ofrecer lo mejor de mí en el dinámico mundo del desarrollo web.",
  },
  {
    fecha: "2020 - 2021",
    titulo: "Argentina Programa 2.0 - Formalización de Estudios",
    descripcion:
      "Avancé en mi carrera al formalizar mis estudios en programación a través del programa Argentina Programa 2.0. Aquí adquirí habilidades sólidas trabajando con frameworks como Angular, optimizando el manejo de diversas tecnologías.",
  },
  {
    fecha: "2009 - 2020",
    titulo: "Autodidacta en Programación",
    descripcion:
      "Mi fascinación por la programación inició en 2015, donde me sumergí en el aprendizaje autodidacta. Navegando por Stack Overflow, tutoriales de YouTube y repositorios en GitHub, adquirí conocimientos fundamentales que han sustentado mi desarrollo continuo.",
  },
];
---

<Layout title="Marcos Zingaretti - Desarrollador Web" description="Desarrollador y Programador web de Páginas Web Personaliadas">
  <main class="flex flex-col m-auto py-10 max-w-3xl">
    <section id="educacion" class="m-auto py-10">
      <h3 class="flex text-4xl font-bold justify-center mb-8 mx-auto px-8 border-2 rounded-full border-acento text-acento">Educacion</h3>
      <ol class="relative border-s border-gray-200 dark:border-gray-700 m-4">
        {
          EDUCACION.map((educacion) => (
            <li class="mb-8 ms-4">
              <div class="absolute w-3 h-3 bg-claro rounded-full mt-1.5 -start-1.5 border border-white" />
              <time class="mb-1 text-sm font-bold leading-none text-medio">{educacion.fecha}</time>
              <h4 class="text-lg font-semibold  text-acento">{educacion.titulo}</h4>
              <p class="mx-4 mb-4 text-base font-light text-claro">{educacion.descripcion}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</Layout>
