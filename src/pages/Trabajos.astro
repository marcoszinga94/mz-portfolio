---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

const TRABAJOS = [
  {
    titulo: "Mister Café",
    url: "https://mistercafe.vercel.app",
    imagen: "mistercafe",
    descripcion: "Tienda e-commerce enfocada en productos de café, destacando un diseño responsivo, aplicando el checkout de MercadoPago",
    stack: ["Astro", "Tailwindcss", "JavaScript"],
    giturl: "https://github.com/marcoszinga94/mistercafe-front",
    caracteristicasDestacadas: ["Integración con MercadoPago", "Diseño responsive", "Catálogo de productos"],
    categoria: "E-commerce",
  },
  {
    titulo: "El Socorro SRL",
    url: "https://elsocorrosrl.com/",
    imagen: "elsocorro",
    descripcion: "Landing page con temática agrícola.",
    stack: ["Astro", "Tailwindcss", "JavaScript"],
    giturl: "https://github.com/marcoszinga94/LandingAgro",
    caracteristicasDestacadas: ["Diseño moderno y limpio", "Formulario de contacto integrado", "Galería de imágenes interactiva"],
    categoria: "Landing Page",
  },
  {
    titulo: "Yuliana Bottos Portafolio",
    url: "https://yulianabottos.vercel.app",
    imagen: "yulibottos",
    descripcion: "Portafolio con un diseño llamativo estilo bento.",
    stack: ["Astro", "Tailwindcss", "TypeScript"],
    giturl: "https://github.com/marcoszinga94/portafolio-yuliana",
    caracteristicasDestacadas: ["Diseño único estilo bento", "Animaciones suaves", "Optimización de rendimiento"],
    categoria: "Portafolio",
  },
  {
    titulo: "A-Mate",
    url: "https://yerbasamate.com/",
    imagen: "a-mate",
    descripcion: "Tienda creada con Wordpress a pedido del cliente.",
    stack: ["Wordpress"],
    rol: "Desarrollador WordPress",
    caracteristicasDestacadas: ["Catálogo de productos extenso", "Blog integrado", "Sistema de reseñas de clientes"],
    categoria: "E-commerce",
  },
  {
    titulo: "Zapatos Yulii",
    url: "https://zapatosyulii.com/",
    imagen: "zapatosyulii",
    descripcion: "Tienda creada con Wordpress a pedido del cliente.",
    stack: ["Wordpress"],
    rol: "Desarrollador WordPress",
    caracteristicasDestacadas: ["Diseño personalizado", "Integración con WooCommerce", "Optimización SEO"],
    categoria: "E-commerce",
  },
];
---

<Layout title="Marcos Zingaretti - Trabajos" description="Desarrollador y Programador web de Páginas Web Personalizadas">
  <main class="flex flex-col m-auto max-w-3xl">
    <h3 class="flex text-4xl font-bold justify-center mb-8 mx-auto px-8 border-2 rounded-full border-acento text-acento">
      Trabajos
    </h3>
    <div class="grid grid-cols-2 gap-4 m-auto">
      {TRABAJOS.map((trabajo) => (
        <a href={trabajo.url} target="_blank" class="block">
          <div class="flex flex-col bg-gradient-to-t from-fondo to-transparent rounded-xl overflow-hidden hover:scale-105 transition-transform duration-300">
            <!-- IMAGEN -->
            <Image
              src={`/Images/paginas/${trabajo.imagen}.webp`}
              alt={trabajo.descripcion}
              width={1920}
              height={940}
              class="w-auto h-52 max-h-full object-cover"
            />

            <div class="p-4 flex flex-col justify-between">
              <div class="flex flex-col gap-3">
                <h4 class="font-semibold text-lg text-acento">{trabajo.titulo}</h4>
                <p class="text-xs text-medio">{trabajo.descripcion}</p>
                <div class="text-xs text-medio text-pretty">
                  <p class="font-semibold">Características destacadas:</p>
                  <ul class="list-disc list-inside">
                    {trabajo.caracteristicasDestacadas.map((caracteristica) => (
                      <li>{caracteristica}</li>
                    ))}
                  </ul>
                </div>
                <p class="text-xs text-medio">Categoría: {trabajo.categoria}</p>
              </div>
              <div class="flex flex-wrap gap-3">
                {trabajo.stack.map((stack) => (
                  <Image
                    src={`/Images/stacks/${stack}.svg`}
                    alt={`Icono de ${stack}`}
                    width={40}
                    height={40}
                    class="size-6 hover:scale-125 transition-transform duration-300"
                  />
                ))}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
  
</Layout>
