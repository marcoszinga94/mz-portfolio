---
import Layout from "../layouts/Layout.astro";
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";

export const prerender = true;
---

<Layout
  title="Página no encontrada - Marcos F. Zingaretti"
  description="La página que buscás no existe. Volvé al inicio para ver mis servicios y proyectos de desarrollo web."
>
  <section class="flex min-h-[70vh] flex-col items-center justify-center text-center">
    <p class="text-sm font-semibold tracking-widest text-acento">Error 404</p>
    <h1 class="mt-4 text-6xl font-extrabold sm:text-8xl">Página no encontrada</h1>
    <p class="mt-4 max-w-md text-lg text-claro/70">
      La dirección que abriste no existe o se movió. Puedo ayudarte a volver al camino.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-full bg-acento px-6 py-3 text-base font-semibold text-white transition-transform duration-300 ease-fluid hover:scale-[1.03] active:scale-[0.98]"
      >
        Volver al inicio
      </a>
      <WhatsAppButton label="Escribime por WhatsApp" />
    </div>
  </section>
</Layout>
