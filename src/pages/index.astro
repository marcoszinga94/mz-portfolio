---
import Layout from "../layouts/Layout.astro";
import Encabezado from "../components/Encabezado.astro";
import Sobremi from "../components/Sobremi.astro";
import Proyectos from "../components/Proyectos.astro";
import Experiencia from "../components/Experiencia.astro";
import Section from "../components/SectionContainer.astro";
import Navegador from "../components/Navegador.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<Layout title="Marcos Zingaretti - Desarrollador Web" description="Desarrollador y Programador web de páginas web personaliadas">
  <Header />
  <main>
    <Encabezado />

    <Section id="sobremi">
      <Sobremi />
    </Section>

    <Section id="experiencia">
      <Experiencia />
    </Section>

    <Section id="proyectos">
      <Proyectos />
    </Section>

    <Footer />
    <Navegador />
  </main>
</Layout>
