---
import Button from "../components/ui/button.astro";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

const PROYECTOS = [
  {
    nombre: "Argentista",
    enlace: "https://argentista.vercel.app",
    imagen: "argentista",
    descripcion:
      "Aplicación interactiva que utiliza APIs para mostrar datos económicos de Argentina.",
    tecnologias: ["Astro", "React", "Tailwind", "JavaScript"],
    caracteristicas: [
      "Integración con APIs",
      "Visualización de datos mediante gráficas",
      "Diseño responsivo adaptado a diversos dispositivos",
    ],
    categoria: "Economía",
  },
  {
    nombre: "Tasador de Propiedades",
    enlace: "https://argensador.vercel.app/",
    imagen: "tasador",
    descripcion:
      "Aplicación interactiva que se usa para cotizar/tasar propiedades.",
    tecnologias: ["Astro", "React", "Tailwind", "JavaScript"],
    caracteristicas: [
      "Servicio privado para inmobiliaria con autenticación",
      "Calcular valor de propiedades con depreciacion",
      "Opción para guardar y gestionar tasaciones previas",
    ],
    categoria: "Herramientas",
  },
  {
    nombre: "El Socorro SRL",
    enlace: "https://elsocorrosrl.com/",
    imagen: "elsocorro",
    descripcion: "Landing page con enfoque en el sector agrícola",
    tecnologias: ["Astro", "Tailwind", "JavaScript"],
    repositorio: "https://github.com/marcoszinga94/LandingAgro",
    caracteristicas: [
      "Diseño tradicional y elegante",
      "Diseño responsivo para diferentes dispositivos",
    ],
    categoria: "Landing Page",
  },
];

const HISTORIAL = [
  {
    fecha: "...Actualidad",
    titulo: "Desarrollador Web Full-Stack",
    descripcion:
      "Comprometido con la mejora continua mediante proyectos independientes, me esfuerzo a diario por ofrecer soluciones innovadoras y de calidad en el dinámico entorno del desarrollo web.",
  },
  {
    fecha: "2020 - 2021",
    titulo: "Argentina Programa 2.0 - Formalización de Estudios",
    descripcion:
      "Avancé en mi trayectoria profesional formalizando mis estudios en programación a través del programa Argentina Programa 2.0. Durante esta etapa, adquirí competencias avanzadas trabajando con frameworks como Angular y optimizando el uso de diversas tecnologías.",
  },
  {
    fecha: "2009 - 2020",
    titulo: "Autodidacta en Programación",
    descripcion:
      "Mi pasión por la programación comenzó en 2015, cuando inicié mi aprendizaje autodidacta. A través de plataformas como Stack Overflow, tutoriales en YouTube y repositorios de GitHub, desarrollé las bases fundamentales que han impulsado mi crecimiento constante en el campo.",
  },
];

const isClient = Astro.request.headers.get("sec-fetch-mode") === "navigate";
---

<Layout
  title="Marcos Zingaretti - Desarrollador Web"
  description="Desarrollador y Programador web de Páginas Web Personalizadas"
>
  <mains
    class="flex flex-col gap-16 max-w-screen-xl mx-auto px-4 py-12 mt-20 min-h-[75vh]"
  >
    <!-- Inicio -->
    <section
      id="inicio"
      class="section flex flex-col justify-center lg:flex-row items-center gap-8 m-auto min-h-[75vh] opacity-0 transform translate-y-20 transition-all duration-500"
    >
      <Image
        title="Foto de Marcos Hover"
        alt="Foto de Marcos Zingaretti, con estilo anime"
        src="/Images/selfie.png"
        width={540}
        height={720}
        loading="eager"
        class="rounded-full h-64 lg:h-96 w-auto object-cover"
      />
      <div class="flex flex-col gap-6 text-center lg:text-left">
        <div>
          <h1
            class="flex flex-col text-4xl lg:text-5xl text-acento font-bold mb-2"
          >
            Marcos Federico
            <span class="text-6xl lg:text-7xl text-acento font-black"
              >Zingaretti</span
            >
          </h1>
        </div>
        <h2 class="text-xl lg:text-2xl text-claro font-semibold">
          Desarrollador Web Full-Stack
        </h2>
        <div class="flex flex-row gap-4">
          <Button
            target="_blank"
            url="https://www.linkedin.com/in/marcos-zingaretti/"
            >Disponible para trabajar</Button
          >
          <Button target="_blank" url="/CV_Marcos_Zingaretti.pdf"
            >Descargar CV</Button
          >
        </div>
      </div>
    </section>

    <!-- Proyectos -->
    <section
      id="proyectos"
      class="section max-w-screen-md mx-auto opacity-0 transform translate-y-20 transition-all duration-500"
    >
      <h3 class="text-4xl font-bold text-center mb-12 text-acento">
        Proyectos Destacados
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          PROYECTOS.length > 0 && (
            <a
              href={PROYECTOS[0].enlace}
              target="_blank"
              class="group col-span-1 md:col-span-2 lg:col-span-2"
            >
              <article class="bg-fondo rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 flex flex-col md:flex-row min-h-96">
                <Image
                  src={`/Images/paginas/${PROYECTOS[0].imagen}.webp`}
                  alt={PROYECTOS[0].descripcion}
                  width={533}
                  height={830}
                  class="w-full md:w-1/2 object-contain object-center m-auto"
                />

                <div class=" flex flex-col p-6 gap-8 md:w-1/2 m-auto">
                  <div class="flex flex-col gap-1">
                    <h4 class="font-bold text-2xl text-acento">
                      {PROYECTOS[0].nombre}
                    </h4>
                    <p class="text-claro">{PROYECTOS[0].descripcion}</p>
                  </div>

                  <div class="flex flex-col gap-1">
                    <p class="font-semibold text-medio">
                      Características destacadas:
                    </p>
                    <ul class="list-disc list-inside text-claro">
                      {PROYECTOS[0].caracteristicas.map((caracteristica) => (
                        <li>{caracteristica}</li>
                      ))}
                    </ul>
                  </div>

                  <div class="flex flex-col gap-1">
                    <p class="text-sm text-medio">Tecnologías usadas:</p>
                    <div class="flex flex-wrap gap-3">
                      {PROYECTOS[0].tecnologias.map((stack) => (
                        <Image
                          src={`/Images/stacks/${stack}.svg`}
                          alt={`Icono de ${stack}`}
                          width={40}
                          height={40}
                          class="w-8 h-8 hover:scale-110 transition-transform duration-300"
                        />
                      ))}
                    </div>
                  </div>
                </div>
              </article>
            </a>
          )
        }

        {
          PROYECTOS.slice(1).map((proyecto) => (
            <a href={proyecto.enlace} target="_blank" class="group">
              <article class="bg-fondo rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 ease-out md:min-h-[650px] md:max-h-[700px]">
                <Image
                  src={`/Images/paginas/${proyecto.imagen}.webp`}
                  alt={proyecto.descripcion}
                  width={533}
                  height={830}
                  class="w-full h-52 object-cover object-top"
                />
                <div class=" flex flex-col p-6 gap-8 m-auto">
                  <div class="flex flex-col gap-1">
                    <h4 class="font-bold text-2xl text-acento">
                      {proyecto.nombre}
                    </h4>
                    <p class="text-claro">{proyecto.descripcion}</p>
                  </div>

                  <div class="flex flex-col gap-1">
                    <p class="font-semibold text-medio">
                      Características destacadas:
                    </p>
                    <ul class="list-disc list-inside text-claro">
                      {proyecto.caracteristicas.map((caracteristica) => (
                        <li>{caracteristica}</li>
                      ))}
                    </ul>
                  </div>

                  <div class="flex flex-col gap-1">
                    <p class="text-sm text-medio">Tecnologías usadas:</p>
                    <div class="flex flex-wrap gap-3">
                      {proyecto.tecnologias.map((stack) => (
                        <Image
                          src={`/Images/stacks/${stack}.svg`}
                          alt={`Icono de ${stack}`}
                          width={40}
                          height={40}
                          class="w-8 h-8 hover:scale-110 transition-transform duration-300"
                        />
                      ))}
                    </div>
                  </div>
                </div>
              </article>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Sobre mi -->
    <section
      id="sobre-mi"
      class="section max-w-screen-md mx-auto opacity-0 transform translate-y-20 transition-all duration-500"
    >
      <h3 class="text-4xl font-bold text-center mb-8 text-acento">Sobre mí</h3>
      <div
        class="bg-gradient-to-br from-fondo to-oscuro rounded-3xl p-8 shadow-2xl flex flex-col gap-6 text-lg text-claro text-center max-w-3xl mx-auto"
      >
        <p>
          Desde pequeño, la tecnología captó mi atención, y a los 15 años
          descubrí que escribir código era mucho más interesante que cualquier
          otra cosa, excepto por los videojuegos.
        </p>

        <p>
          Comencé con pequeños proyectos, intentando entender que hacía cada
          línea. Con el tiempo, comprendí que la programación no es solo sobre
          código, sino sobre crear soluciones.
        </p>

        <p>
          Hoy, con una sólida experiencia, desarrollo proyectos desde cero,
          aplicando lo aprendido y evitando —en lo posible— los errores.
        </p>
        <p>Si te interesa trabajar conmigo:</p>
        <div class="flex flex-row gap-4 m-auto">
          <Button
            target="_blank"
            url="https://www.linkedin.com/in/marcos-zingaretti/"
            >Disponible para trabajar</Button
          >
          <Button target="_blank" url="/CV_Marcos_Zingaretti.pdf"
            >Descargar CV</Button
          >
        </div>
      </div>
    </section>

    <!-- Trayectoria -->
    <section
      id="trayectoria"
      class="section max-w-screen-md mx-auto opacity-0 transform translate-y-20 transition-all duration-500"
    >
      <h3 class="text-4xl font-bold text-center mb-12 text-acento">
        Mi Trayectoria
      </h3>
      <ol class="relative border-l-2 border-acento">
        {
          HISTORIAL.map((historial) => (
            <li class="mb-10 ml-6">
              <span class="absolute flex items-center justify-center size-6 bg-acento rounded-full -left-3" />
              <time class="block mb-2 text-sm font-normal leading-none text-medio">
                {historial.fecha}
              </time>
              <h4 class="text-lg font-semibold text-acento mb-2">
                {historial.titulo}
              </h4>
              <p class="mb-4 text-base font-normal text-claro">
                {historial.descripcion}
              </p>
            </li>
          ))
        }
      </ol>
    </section>
  </mains>
</Layout>

<style>
  .section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const sections = document.querySelectorAll(".section");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
        }
      });
    },
    {
      threshold: 0.2,
    }
  );

  sections.forEach((section) => {
    observer.observe(section);
  });
</script>
