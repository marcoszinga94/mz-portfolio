---
import Layout from "../layouts/Layout.astro";
import Encabezado from "../sections/Encabezado.astro";
import Sobremi from "../sections/Sobremi.astro";
import Trabajos from "../sections/Trabajos.astro";
import Experiencia from "../sections/Experiencia.astro";
import Section from "../components/SectionContainer.astro";
import Navegador from "../sections/Navegador.astro";
import Footer from "../sections/Footer.astro";
import Header from "../sections/Header.astro";
---

<Layout title="Marcos Zingaretti - Desarrollador Web" description="Desarrollador y Programador web de Páginas Web Personaliadas">
  <Header />
  <main>
    <Encabezado />

    <Section id="sobremi">
      <Sobremi />
    </Section>

    <Section id="trabajos">
      <Trabajos />
    </Section>

    <Section id="experiencia">
      <Experiencia />
    </Section>

    <Footer />

    <Navegador />
  </main>
</Layout>
