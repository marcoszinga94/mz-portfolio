---
import Layout from "../layouts/Layout.astro";
import Encabezado from "../components/Section/Encabezado.astro";
import Sobremi from "../components/Section/Sobremi.astro";
import Trabajos from "../components/Section/Trabajos.astro";
import Experiencia from "../components/Section/Experiencia.astro";
import Section from "../components/Componentes/SectionContainer.astro";
import Navegador from "../components/Section/Navegador.astro";
import Footer from "../components/Section/Footer.astro";
import Header from "../components/Section/Header.astro";
---

<Layout title="Marcos Zingaretti - Desarrollador Web" description="Desarrollador y Programador web de Páginas Web Personaliadas">
  <Header />
  <main>
    <Encabezado />

    <Section id="sobremi">
      <Sobremi />
    </Section>

    <Section id="trabajos">
      <Trabajos />
    </Section>

    <Section id="experiencia">
      <Experiencia />
    </Section>

    <Footer />

    <Navegador />
  </main>
</Layout>
