---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout title="Marcos Zingaretti - Inicio" description="Desarrollador y Programador web de Páginas Web Personalizadas">
  <main class="flex flex-col lg:flex-row gap-4 m-auto">
    <Image
      title="Foto de Marcos"
      alt="Foto de Marcos Zingaretti usando una campera de jean"
      src="/Images/selfie.webp"
      width={540}
      height={720}
      loading="eager"
      class="rounded-full h-[250px] lg:h-[500px] w-auto m-auto"
    />
    <div class="flex flex-col m-auto gap-8">
      <div class="flex flex-col gap-2">
        <h1 class="text-3xl lg:text-6xl text-center lg:text-left text-acento">Marcos Federico</h1>
        <h2 class="text-5xl lg:text-8xl text-center lg:text-left text-acento font-black">Zingaretti</h2>
      </div>
      <div class="flex flex-col gap-2">
        <h3 class="text-lg lg:text-3xl text-acento text-left">Desarrollador Web Full-Stack</h3>
        <a target="_blank" href="https://www.linkedin.com/in/marcos-zingaretti/" class="flex justify-center lg:justify-end">
          <span class="animate-pulse bg-claro text-acento text-sm lg:text-base font-medium px-4 py-2 rounded border-acento">Disponible para Trabajar</span>
        </a>
      </div>
    </div>
  </main>
</Layout>
