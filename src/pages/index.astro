---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout title="Marcos Zingaretti - Inicio" description="Desarrollador y Programador web de Páginas Web Personalizadas">
  <main class="flex flex-col m-auto max-w-3xl items-center">
    <div class="max-w-3xl mx-auto flex lg:flex-row flex-col items-center min-h-[75vh] max-h-screen">
      <Image
        title="Foto de Marcos"
        alt="Foto de Marcos Zingaretti usando una campera de jean"
        src="/Images/selfie.webp"
        width={540}
        height={720}
        loading="eager"
        class="rounded-full items-center h-[450px] w-auto"
      />
      <div class="flex flex-col items-center text-center">
        <h1 class="text-5xl pt-8 text-acento text-center">Marcos Federico <span class="font-black text-center text-7xl">Zingaretti</span></h1>
        <h2 class="text-2xl py-4 text-acento text-center">Desarrollador Web Full-Stack</h2>
        <a target="_blank" href="https://www.linkedin.com/in/marcos-zingaretti/">
          <span class={`animate-pulse bg-claro text-acento text-lg font-medium px-3 py-2 rounded border-acento`}>Disponible para Trabajar</span>
        </a>
      </div>
    </div>
  </main>
</Layout>
