---
import Button from "../components/ui/button.astro";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

const PROYECTOS = [
  {
    nombre: "Argentista",
    enlace: "https://argentista.vercel.app",
    imagen: "argentista",
    descripcion:
      "Aplicación interactiva que utiliza APIs para mostrar datos económicos de Argentina.",
    tecnologias: ["Astro", "React", "TailwindCSS", "JavaScript"],
    caracteristicas: [
      "Integración con APIs",
      "Visualización de datos mediante gráficas",
      "Diseño responsivo adaptado a diversos dispositivos",
    ],
    categoria: "Economía",
  },
  {
    nombre: "El Socorro SRL",
    enlace: "https://elsocorrosrl.com/",
    imagen: "elsocorro",
    descripcion: "Landing page con enfoque en el sector agrícola",
    tecnologias: ["Astro", "TailwindCSS", "JavaScript"],
    repositorio: "https://github.com/marcoszinga94/LandingAgro",
    caracteristicas: [
      "Diseño tradicional y elegante",
      "Diseño responsivo para diferentes dispositivos",
    ],
    categoria: "Landing Page",
  },
];

const HISTORIAL = [
  {
    fecha: "...Actualidad",
    titulo: "Desarrollador Web Full-Stack",
    descripcion:
      "Comprometido con la mejora continua mediante proyectos independientes, me esfuerzo a diario por ofrecer soluciones innovadoras y de calidad en el dinámico entorno del desarrollo web.",
  },
  {
    fecha: "2020 - 2021",
    titulo: "Argentina Programa 2.0 - Formalización de Estudios",
    descripcion:
      "Avancé en mi trayectoria profesional formalizando mis estudios en programación a través del programa Argentina Programa 2.0. Durante esta etapa, adquirí competencias avanzadas trabajando con frameworks como Angular y optimizando el uso de diversas tecnologías.",
  },
  {
    fecha: "2009 - 2020",
    titulo: "Autodidacta en Programación",
    descripcion:
      "Mi pasión por la programación comenzó en 2015, cuando inicié mi aprendizaje autodidacta. A través de plataformas como Stack Overflow, tutoriales en YouTube y repositorios de GitHub, desarrollé las bases fundamentales que han impulsado mi crecimiento constante en el campo.",
  },
];
---

<Layout
  title="Marcos Zingaretti - Desarrollador Web Full-Stack"
  description="Desarrollador y Programador web de Páginas Web Personalizadas"
>
  <main
    class="flex flex-col gap-16 max-w-screen-xl mx-auto px-4 py-12 mt-20 min-h-[75vh]"
  >
    <!-- Inicio -->
    <section
      id="inicio"
      class="flex flex-col lg:flex-row items-center gap-8 m-auto min-h-[75vh]"
    >
      <Image
        title="Foto de Marcos"
        alt="Foto de Marcos Zingaretti"
        src="/Images/selfie.webp"
        width={540}
        height={720}
        loading="eager"
        class="rounded-full h-72 lg:h-96 w-auto object-cover"
      />
      <div class="flex flex-col gap-6 text-center lg:text-left">
        <div>
          <h1 class="text-4xl lg:text-5xl text-acento font-bold mb-2">
            Marcos Federico
          </h1>
          <h2 class="text-6xl lg:text-7xl text-acento font-black">
            Zingaretti
          </h2>
        </div>
        <h3 class="text-xl lg:text-2xl text-claro font-semibold">
          Desarrollador Web Full-Stack
        </h3>
        <div class="flex flex-row gap-4">
          <Button
            target="_blank"
            url="https://www.linkedin.com/in/marcos-zingaretti/"
            >Disponible para trabajar</Button
          >
          <Button target="_blank" url="/CV_Marcos_Zingaretti.pdf"
            >Descargar CV</Button
          >
        </div>
      </div>
    </section>

    <!-- Proyectos -->
    <section id="proyectos" class="max-w-screen-md mx-auto">
      <h3 class="text-4xl font-bold text-center mb-12 text-acento">
        Proyectos Destacados
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          PROYECTOS.map((proyecto) => (
            <a href={proyecto.enlace} target="_blank" class="group">
              <article class="bg-fondo rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
                <Image
                  src={`/Images/paginas/${proyecto.imagen}.webp`}
                  alt={proyecto.descripcion}
                  width={533}
                  height={830}
                  class="w-full h-52 object-cover object-top"
                />
                <div class=" flex flex-col p-6 gap-8">
                  <div class="flex flex-col gap-1">
                    <h4 class="font-bold text-2xl text-acento">
                      {proyecto.nombre}
                    </h4>
                    <p class="text-claro">{proyecto.descripcion}</p>
                  </div>

                  <div class="flex flex-col gap-1">
                    <p class="font-semibold text-medio">
                      Características destacadas:
                    </p>
                    <ul class="list-disc list-inside text-claro">
                      {proyecto.caracteristicas.map((caracteristica) => (
                        <li>{caracteristica}</li>
                      ))}
                    </ul>
                  </div>

                  <div class="flex flex-col gap-1">
                    <p class="text-sm text-medio">Tecnologías usadas:</p>
                    <div class="flex flex-wrap gap-3">
                      {proyecto.tecnologias.map((stack) => (
                        <Image
                          src={`/Images/stacks/${stack}.svg`}
                          alt={`Icono de ${stack}`}
                          width={40}
                          height={40}
                          class="w-8 h-8 hover:scale-110 transition-transform duration-300"
                        />
                      ))}
                    </div>
                  </div>
                </div>
              </article>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Sobre mi -->
    <section
      id="sobre-mi"
      class="bg-gradient-to-br from-fondo to-oscuro rounded-3xl p-8 shadow-2xl max-w-screen-md mx-auto"
    >
      <h3 class="text-4xl font-bold text-center mb-8 text-acento">Sobre mí</h3>
      <div
        class="flex flex-col gap-6 text-lg text-claro text-center max-w-3xl mx-auto"
      >
        <p>
          Desde pequeño, la tecnología captó mi atención, y a los 15 años
          descubrí que escribir código era mucho más interesante que cualquier
          otra cosa.
        </p>

        <p>
          Comencé con pequeños proyectos, desentrañando cada línea como si fuera
          un enigma. Con el tiempo, comprendí que la programación no es solo
          sobre código, sino sobre crear soluciones.
        </p>

        <p>
          Hoy, con una sólida experiencia, desarrollo proyectos desde cero,
          aplicando lo aprendido y evitando —en la medida de lo posible— los
          errores que alguna vez me hicieron replantearme mi carrera.
        </p>
      </div>
    </section>

    <!-- Trayectoria -->
    <section id="trayectoria" class="max-w-screen-md mx-auto">
      <h3 class="text-4xl font-bold text-center mb-12 text-acento">
        Mi Trayectoria
      </h3>
      <ol class="relative border-l-2 border-acento">
        {
          HISTORIAL.map((historial) => (
            <li class="mb-10 ml-6">
              <span class="absolute flex items-center justify-center size-6 bg-acento rounded-full -left-3 ring-4 ring-fondo" />
              <time class="block mb-2 text-sm font-normal leading-none text-medio">
                {historial.fecha}
              </time>
              <h4 class="text-lg font-semibold text-acento mb-2">
                {historial.titulo}
              </h4>
              <p class="mb-4 text-base font-normal text-claro">
                {historial.descripcion}
              </p>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</Layout>
