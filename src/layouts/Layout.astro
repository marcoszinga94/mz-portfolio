---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Background from "../components/ui/Background.astro";
import LegalModal from "../components/ui/LegalModal.astro";
import ScrollToTop from "../components/ui/ScrollToTop.astro";
import WhatsAppFloat from "../components/ui/WhatsAppFloat.astro";
import "@fontsource-variable/manrope";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const site = "https://portafoliozingaretti.vercel.app";
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = `${site}/Images/og-image.jpg`;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Marcos F. Zingaretti",
  description,
  url: site,
  image: ogImage,
  areaServed: "AR",
  priceRange: "$$",
  founder: {
    "@type": "Person",
    name: "Marcos Federico Zingaretti",
    jobTitle: "Desarrollador web full stack",
    sameAs: ["https://github.com/marcoszinga94"],
  },
  knowsAbout: ["Desarrollo web", "Astro", "React", "TypeScript", "Node.js", "TailwindCSS"],
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Desarrollador web, Full Stack Developer, JavaScript, React, Astro, TailwindCSS, páginas web Argentina"
    />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Marcos F. Zingaretti" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>

  <body class="isolate grid min-h-screen grid-rows-[auto_1fr_auto] bg-fondo text-claro">
    <Background />

    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-full focus:bg-acento focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Saltar al contenido
    </a>

    <Header />

    <main
      id="contenido"
      class="relative mx-auto w-full max-w-7xl space-y-24 px-6 pt-28 pb-8 sm:px-8 sm:pt-32 lg:space-y-32"
    >
      <div
        id="scroll-sentinel"
        aria-hidden="true"
        class="pointer-events-none absolute top-0 left-0 h-64 w-px"
      ></div>
      <slot />
    </main>

    <Footer />
    <ScrollToTop />
    <WhatsAppFloat />
    <LegalModal />
  </body>

  <script>
    const headerOffset = 88;

    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", (event) => {
        const targetId = anchor.getAttribute("href");
        if (!targetId || targetId === "#") return;

        const target = document.querySelector(targetId);
        if (!target) return;

        event.preventDefault();
        const top = target.getBoundingClientRect().top + window.scrollY - headerOffset;
        window.scrollTo({ top, behavior: "smooth" });
      });
    });

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
    );

    document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
      const delay = el.dataset.revealDelay;
      if (delay) el.style.setProperty("--reveal-delay", `${delay}ms`);
      revealObserver.observe(el);
    });
  </script>
</html>
