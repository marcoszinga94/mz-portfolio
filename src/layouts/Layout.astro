---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Desarrollador Web, Full-Stack Developer, JavaScript, React, Astro, TailwindCSS"
    />
    <!-- Preload critical assets -->
    <link
      rel="preload"
      href="/Fonts/FiraCode.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="preload" href="/Images/selfie.webp" as="image" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/Images/og-image.png" />
    <meta
      property="og:url"
      content="https://portafoliozingaretti.vercel.app/"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/Images/og-image.png" />
  </head>

  <body
    class="grid grid-rows-[auto_1fr_auto] bg-linear-to-b from-fondo to-oscuro text-claro overflow-x-hidden"
  >
    <elevenlabs-convai agent-id="agent_5601kf6tydjzettr6hqcw87ayj8z"
    ></elevenlabs-convai>
    <script
      is:inline
      src="https://unpkg.com/@elevenlabs/convai-widget-embed"
      async
      type="text/javascript"
    ></script>
    <Header />
    <main
      class="relative pt-20 min-h-screen max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-32 page-content"
    >
      <slot />
    </main>
    <Footer />
  </body>


  <style is:global>
    @font-face {
      font-family: "Fira Code";
      src: url("/Fonts/FiraCode.ttf") format("truetype");
      font-display: swap;
    }

    html {
      scroll-behavior: smooth;
      scrollbar-width: none;
      font-family: "Fira Code", monospace;
    }

    /* Estilos base */
    ::selection {
      background-color: rgba(255, 59, 59, 0.2);
      color: #fff5f5;
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Utilidades de accesibilidad */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .focus-visible:focus-visible {
      outline: 2px solid var(--scrollbar-thumb);
      outline-offset: 2px;
    }
  </style>

  <script>
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = anchor.getAttribute("href");
        if (!targetId) return;

        const target = document.querySelector(targetId);
        if (!target) return;

        const headerOffset = 80;
        const elementPosition = target.getBoundingClientRect().top;
        const offsetPosition =
          elementPosition + window.pageYOffset - headerOffset;

        window.scrollTo({
          top: offsetPosition,
          behavior: "smooth",
        });
      });
    });

    const aosObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("aos-animate");
          }
        });
      },
      { threshold: 0.1 },
    );

    document.querySelectorAll("[data-aos]").forEach((el) => {
      const delay = el.getAttribute("data-aos-delay");
      if (delay) {
        (el as HTMLElement).style.setProperty("--aos-delay", `${delay}ms`);
      }
      aosObserver.observe(el);
    });
  </script>
</html>
