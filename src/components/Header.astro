<header class="fixed top-0 right-0 left-0 bg-black z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center py-4">
      <div class="text-center flex flex-col">
        <span class="text-xl text-acento">Marcos F. Zingaretti</span>
        <span class="hidden lg:block text-lg font-semibold text-acento">
          Desarrollador Web
        </span>
      </div>

      <nav>
        <div class="flex lg:hidden">
          <button
            id="menuButton"
            aria-label="Abrir menú"
            class="text-acento hover:text-medio focus:outline-none"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="size-6"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>

        <ul id="menuItems" class="hidden lg:flex lg:flex-row gap-4">
          <a
            class="p-2 text-acento hover:text-medio font-medium transition-colors duration-300"
            href="#inicio">Inicio</a
          >
          <a
            class="p-2 text-acento hover:text-medio font-medium transition-colors duration-300"
            href="#proyectos">Proyectos</a
          >
          <a
            class="p-2 text-acento hover:text-medio font-medium transition-colors duration-300"
            href="#sobre-mi">Sobre mí</a
          >
          <a
            class="p-2 text-acento hover:text-medio font-medium transition-colors duration-300"
            href="#trayectoria">Trayectoria</a
          >
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  const menuButton = document.getElementById("menuButton");
  const menuItems = document.getElementById("menuItems");

  if (menuButton && menuItems) {
    menuButton.addEventListener("click", () => {
      menuItems.classList.toggle("hidden");
      menuItems.classList.toggle("flex");
      menuItems.classList.toggle("flex-col");
      menuItems.classList.toggle("absolute");
      menuItems.classList.toggle("top-16");
      menuItems.classList.toggle("right-0");
      menuItems.classList.toggle("bg-black");
      menuItems.classList.toggle("p-4");
      menuItems.classList.toggle("rounded-lg");
    });
  }
</script>

<style>
  @media (max-width: 50%) {
    #menuItems {
      width: 100%;
    }
    #menuItems.flex {
      display: flex;
    }
  }
</style>
