---
import type { MenuItem } from "../types";

const developer = "<Desarrollador Web>";

const menuItems: MenuItem[] = [
  { name: "Inicio", url: "#inicio" },
  { name: "Proyectos", url: "#proyectos" },
  { name: "Sobre mí", url: "#sobre-mi" },
  { name: "Trayectoria", url: "#trayectoria" },
];
---

<header
  class="fixed top-0 right-0 left-0 z-50 backdrop-blur-sm bg-gradient-to-b from-black to-transparent"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="relative z-10 flex flex-row gap-2 items-center">
        <span class="text-lg text-acento font-bold tracking-tight">
          Marcos F. Zingaretti
        </span>
        <span class="hidden lg:flex text-sm font-medium text-claro/70">
          {developer}
        </span>
      </div>

      <!-- Mobile menu button -->
      <div class="lg:hidden">
        <button
          id="menuButton"
          aria-label="Menú de navegación"
          class="relative z-10 p-2 text-acento hover:text-medio focus:outline-none transition-colors"
        >
          <div class="w-6 h-5 flex flex-col justify-between">
            <span
              class="w-full h-0.5 bg-current transform transition-all duration-300"
              id="line1"></span>
            <span
              class="w-full h-0.5 bg-current transform transition-all duration-300"
              id="line2"></span>
            <span
              class="w-full h-0.5 bg-current transform transition-all duration-300"
              id="line3"></span>
          </div>
        </button>
      </div>

      <!-- Desktop navigation -->
      <nav class="hidden lg:block">
        <ul class="flex items-center gap-6">
          {
            menuItems.map(({ name, url }) => (
              <li>
                <a
                  href={url}
                  class="relative py-2 text-claro/70 hover:text-acento transition-colors duration-300"
                >
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Mobile navigation -->
      <nav
        id="mobileMenu"
        class="fixed top-16 inset-x-0 bottom-0 bg-fondo/95 backdrop-blur-lg transform translate-x-full transition-transform duration-300 lg:hidden min-h-[calc(100vh-4rem)] flex items-center justify-center z-[100] shadow-[0_8px_32px_0_rgba(0,0,0,0.25)]"
      >
        <ul
          class="h-full flex flex-col items-center justify-center gap-6 text-xl pb-16 px-4 w-full p-0 m-0"
        >
          {
            menuItems.map(({ name, url }) => (
              <li>
                <a
                  href={url}
                  class="text-claro hover:text-acento transition-all duration-300 text-base p-2 rounded-md bg-[rgba(26,26,46,0.97)] w-[90%] text-center max-w-[90%] tracking-[0.02em] font-medium shadow-[0_2px_8px_0_rgba(0,0,0,0.1)] my-1 mx-auto hover:bg-[rgba(255,255,255,0.08)] hover:translate-x-[2px] hover:scale-[1.02]"
                >
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  interface HeaderElements {
    menuButton: HTMLElement | null;
    mobileMenu: HTMLElement | null;
    line1: HTMLElement | null;
    line2: HTMLElement | null;
    line3: HTMLElement | null;
    closeMenuButton: HTMLElement | null;
  }

  const elements: HeaderElements = {
    menuButton: document.getElementById("menuButton"),
    mobileMenu: document.getElementById("mobileMenu"),
    line1: document.getElementById("line1"),
    line2: document.getElementById("line2"),
    line3: document.getElementById("line3"),
    closeMenuButton: document.getElementById("closeMenuButton"),
  };

  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    const { mobileMenu, line1, line2, line3 } = elements;

    if (isOpen) {
      mobileMenu?.classList.remove("translate-x-full");
      line1?.classList.add("rotate-45", "translate-y-2");
      line2?.classList.add("opacity-0");
      line3?.classList.add("-rotate-45", "-translate-y-2");
      document.body.style.overflow = "hidden";
    } else {
      mobileMenu?.classList.add("translate-x-full");
      line1?.classList.remove("rotate-45", "translate-y-2");
      line2?.classList.remove("opacity-0");
      line3?.classList.remove("-rotate-45", "-translate-y-2");
      document.body.style.overflow = "";
    }
  }

  elements.menuButton?.addEventListener("click", toggleMenu);
  elements.closeMenuButton?.addEventListener("click", function () {
    if (isOpen) toggleMenu();
  });

  // Cerrar menú al hacer click en un enlace
  document.querySelectorAll("#mobileMenu a").forEach((link) => {
    link.addEventListener("click", () => {
      if (isOpen) toggleMenu();
    });
  });
</script>
