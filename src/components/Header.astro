---
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
---

<header class="py-3 sticky top-0 right-0 left-0 bg-gradient-to-b from-black via-black via-75% to-transparent z-50 flex flex-row justify-around">
  <div class="text-center flex justify-center flex-col">
    <p class="text-2xl">Marcos F. Zingaretti</p>
    <p class="text-xl font-semibold">Desarrollador Web</p>
  </div>

  <div>
    <Astronav>
      <div class="flex flex-col lg:hidden">
        <MenuIcon class="w-8 h-8 text-white" />
      </div>

      <MenuItems class="relative hidden lg:flex flex-row gap-4 m-auto">
        <div class="lg:static flex flex-col lg:flex-row absolute top-0 right-0 gap-4 m-auto bg-oscuro rounded-lg p-6 bg-[#191e28]">
          <a class="flex flex-col text-center border rounded-lg p-2 hover:bg-gray-700 bg-black" href="#top" title="Home">Inicio </a>
          <a class="flex flex-col text-center border rounded-lg p-2 hover:bg-gray-700 bg-black" href="#sobremi" title="About">Sobre mí </a>
          <a class="flex flex-col text-center border rounded-lg p-2 hover:bg-gray-700 bg-black" href="#trabajos" title="Works">Trabajos </a>
          <a class="flex flex-col text-center border rounded-lg p-2 hover:bg-gray-700 bg-black" href="#experiencia" title="Experience">Experiencia </a>
        </div>
      </MenuItems>
    </Astronav>
  </div>
</header>
