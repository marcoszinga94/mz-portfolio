---
const TRABAJOS = [
  {
    url: "https://elsocorrosrl.com/",
    imagen: "elsocorro.webp",
    titulo: "El Socorro SRL",
    descripcion: "Landing Page creada desde cero con Astro y Tailwind CSS",
  },
  {
    url: "https://zapatosyulii.com/",
    imagen: "zapatosyulii.webp",
    titulo: "Zapatos Yulii",
    descripcion: "Tienda creada en Wordpress",
  },
  {
    url: "https://yerbasamate.com/",
    imagen: "a-mate.webp",
    titulo: "A-Mate",
    descripcion: "Tienda creada en Wordpress",
  },
  {
    url: "https://lcesports.vercel.app",
    imagen: "lcesports.webp",
    titulo: "LCE",
    descripcion: "Página web con blog creada para una comunidad gamer de mi ciudad. EN PROCESO",
  },
];
---

<h3 class="flex text-4xl font-bold justify-center mb-8 mx-auto px-8 border-2 rounded-full">Trabajos</h3>
<div id="bento" class="grid grid-cols-2 gap-4 px-3">
  {
    TRABAJOS.map((trabajos) => (
      <div>
        <a href=`${trabajos.url}` target="_blank">
        <div class="flex flex-col bg-gradient-to-t from-gray-700 to-transparent rounded-xl">
          <img
            class="hover:scale-105 hover:shadow-xl active:scale-95 active:shadow-lg transition-transform rounded-xl w-auto h-full"
            src=`/Images/${trabajos.imagen}`
            alt=`${trabajos.descripcion}`
          />
    <h4 class="font-bold text-xl text-center">{trabajos.titulo}</h4>
    <p class="text-center text-sm">{trabajos.descripcion}</p>
  </div>
</a>
      </div>
    ))
  }
</div>

<style>
  #bento div:first-child {
    grid-column: 1 /-1;
  }
  #bento div:last-child {
    grid-column: 1 /-1;
  }
</style>
