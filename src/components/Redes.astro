---
import Section from "./SectionContainer.astro";
---

<Section>
  <div class="flex flex-row justify-center m-auto p-auto">
    <ul class="flex flex-row gap-10">
      <li>
        <div class="card">
          <div class="front face">
            <img src="/Images/instagram.svg" alt="" class="size-10" />
          </div>
          <div class="back face">
            <a target="_blank" href="https://www.instagram.com/marcosfzinga/" class="text-xl flex justify-center" rel="noopener">Instagram</a>
          </div>
        </div>
      </li>
      <li>
        <div class="card">
          <div class="face front">
            <img src="/Images/linkedin.svg" alt="" class="size-10" />
          </div>
          <div class="face back">
            <a target="_blank" href="https://www.linkedin.com/in/marcos-zingaretti/" class="text-xl flex justify-center" rel="noopener">LinkedIn</a>
          </div>
        </div>
      </li><li>
        <div class="card">
          <div class="front face">
            <img src="/Images/whatsapp.svg" alt="" class="size-10" />
          </div>
          <div class="back face">
            <a target="_blank" href="https://wa.link/tle2k3" class="text-xl flex justify-center" rel="noopener">Whatsapp</a>
          </div>
        </div>
      </li><li>
        <div class="card">
          <div class="front face">
            <img src="/Images/email.svg" alt="" class="size-10" />
          </div>
          <div class="back face">
            <a target="_blank" href="mailto:marcoszinga94@gmail.com" class="text-xl flex justify-center" rel="noopener">Email</a>
          </div>
        </div>
      </li>
    </ul>
  </div>
</Section>

<style>
  .card {
    position: relative;
    width: 50px;
    height: 50px;
  }
  .card .face {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    transition: 0.5s;
  }

  .card .front {
    transform: perspective(100px) rotateY(0deg);
  }
  .card:hover .front {
    transform: perspective(100px) rotateY(180deg);
  }

  .card .back {
    transform: perspective(100px) rotateY(180deg);
  }
  .card:hover .back {
    transform: perspective(100px) rotateY(0deg);
  }
</style>
