<style>
  .card {
    position: relative;
    width: 50px;
    height: 50px;
  }
  .card .face {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    transition: 0.5s;
  }

  .card .front {
    transform: perspective(100px) rotateY(0deg);
  }
  .card:hover .front {
    transform: perspective(100px) rotateY(180deg);
  }

  .card .back {
    transform: perspective(100px) rotateY(180deg);
  }
  .card:hover .back {
    transform: perspective(100px) rotateY(0deg);
  }
</style>
