---
import data from "../data/cv";

const email = data.socialLinks.find((s) => s.name === "Email")!;
const whatsapp = data.socialLinks.find((s) => s.name === "WhatsApp")!;
const github = data.socialLinks.find((s) => s.name === "GitHub")!;
---

<footer class="relative mt-20">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-gray-custom/30 to-fondo"></div>

  <div class="container mx-auto px-6 py-12 pb-20 md:pb-12 relative">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-claro/70 mb-8">¿Tienes un proyecto en mente? ¡Hablemos!</h2>

<div class="flex flex-row gap-4 justify-center">
        <a
          class="px-4 py-2 text-base inline-flex items-center justify-center rounded-lg font-medium transition-all duration-300 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-acento focus-visible:ring-offset-2 focus-visible:ring-offset-fondo disabled:opacity-50 disabled:cursor-not-allowed transform hover:scale-[1.02] active:scale-[0.98] border-2 border-acento text-acento hover:bg-acento/10"
          href={`mailto:${email.url}`}
        >
          <span class="mr-2">
            <svg
              class="size-auto"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d={email.icon}></path>
            </svg>
          </span>
          Email
        </a>

        <a
          class="px-4 py-2 text-base inline-flex items-center justify-center rounded-lg font-medium transition-all duration-300 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-acento focus-visible:ring-offset-2 focus-visible:ring-offset-fondo disabled:opacity-50 disabled:cursor-not-allowed transform hover:scale-[1.02] active:scale-[0.98] border-2 border-acento text-acento hover:bg-acento/10"
          href={whatsapp.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="mr-2">
            <svg
              class="size-auto"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 20 20"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d={whatsapp.icon}></path>
            </svg>
          </span>
          WhatsApp
        </a>

        <a
          class="px-4 py-2 text-base inline-flex items-center justify-center rounded-lg font-medium transition-all duration-300 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-acento focus-visible:ring-offset-2 focus-visible:ring-offset-fondo disabled:opacity-50 disabled:cursor-not-allowed transform hover:scale-[1.02] active:scale-[0.98] border-2 border-acento text-acento hover:bg-acento/10"
          href={github.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <span class="mr-2">
            <svg
              class="size-6 fill-current"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d={github.icon} />
            </svg>
          </span>
          GitHub
        </a>
      </div>

      <div class="mt-8 text-sm text-claro/50">
        <p>Diseñado y desarrollado por Marcos F. Zingaretti</p>
      </div>
    </div>
  </div>

  <!-- Decorative elements -->
  <div
    class="absolute bottom-0 left-0 w-64 h-64 bg-acento/5 rounded-full blur-3xl animate-pulse"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute bottom-0 right-0 w-64 h-64 bg-medio/5 rounded-full blur-3xl animate-float"
    aria-hidden="true"
  >
  </div>
</footer>
