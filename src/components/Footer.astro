---
import SocialLinks from "../components/ui/socialLinks.astro";
---

<footer class="relative mt-20">
  <div
    class="absolute inset-0 bg-gradient-to-b from-transparent via-gray-custom/30 to-fondo"
  >
  </div>

  <div class="container mx-auto px-6 py-12 relative">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-claro/70 mb-8">
        ¿Tienes un proyecto en mente? ¡Hablemos!
      </h2>

      <a
        href="mailto:marcoszinga94@gmail.com"
        class="inline-block px-8 py-3 text-lg font-medium text-claro bg-gradient-to-r from-acento to-medio rounded-full transform hover:scale-105 transition-all duration-300 hover:shadow-lg hover:shadow-acento/20"
        rel="noopener noreferrer"
      >
        Email
      </a>

      <a
        class="inline-block px-8 py-3 text-lg font-medium text-claro bg-gradient-to-r from-acento to-medio rounded-full transform hover:scale-105 transition-all duration-300 hover:shadow-lg hover:shadow-acento/20"
        href="https://wa.me/+5493584406950"
        target="_blank"
        rel="noopener noreferrer"
      >
        WhatsApp
      </a>

      <div
        class="mt-12 flex justify-center space-x-6"
        role="list"
        aria-label="Enlaces sociales"
      >
        <SocialLinks class="hidden lg:flex" />
      </div>

      <div class="mt-8 text-sm text-claro/50">
        <p>Diseñado y desarrollado por Marcos F. Zingaretti</p>
      </div>
    </div>
  </div>

  <!-- Decorative elements -->
  <div
    class="absolute bottom-0 left-0 w-64 h-64 bg-acento/5 rounded-full blur-3xl animate-pulse"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute bottom-0 right-0 w-64 h-64 bg-medio/5 rounded-full blur-3xl animate-float"
    aria-hidden="true"
  >
  </div>
</footer>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.5;
    }
    50% {
      opacity: 0.2;
    }
  }

  .animate-pulse {
    animation: pulse 4s ease-in-out infinite;
  }
</style>
