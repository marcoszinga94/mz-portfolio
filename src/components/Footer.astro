---
import { Icon } from "astro-icon/components";
import data from "../data/cv";

const iconByName: Record<string, string> = {
  Email: "ph:envelope-simple",
  WhatsApp: "ph:whatsapp-logo",
  GitHub: "ph:github-logo",
  LinkedIn: "ph:linkedin-logo",
  Instagram: "ph:instagram-logo",
};

const year = new Date().getFullYear();
---

<footer class="mt-8 border-t border-borde">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-6 px-6 py-10 text-center sm:px-8">
    <div class="flex items-center gap-3">
      {data.socialLinks.map(({ name, url }) => (
        <a
          href={name === "Email" ? `mailto:${url}` : url}
          target={name === "Email" ? undefined : "_blank"}
          rel={name === "Email" ? undefined : "noopener noreferrer"}
          aria-label={name}
          class="grid size-10 place-items-center rounded-full border border-borde text-claro/60 transition-colors duration-300 ease-fluid hover:border-acento hover:text-acento"
        >
          <Icon name={iconByName[name]} class="size-5" />
        </a>
      ))}
    </div>

    <nav
      class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-claro/70"
      aria-label="Zonas de servicio"
    >
      <a
        href="/desarrollo-web-la-carlota"
        class="transition-colors duration-300 ease-fluid hover:text-claro"
      >
        Desarrollo web en La Carlota
      </a>
      <a
        href="/desarrollo-web-cordoba"
        class="transition-colors duration-300 ease-fluid hover:text-claro"
      >
        Desarrollo web en Córdoba
      </a>
    </nav>

    <nav
      class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-claro/60"
      aria-label="Enlaces legales"
    >
      <button
        type="button"
        data-legal="privacy"
        class="cursor-pointer text-sm text-claro/60 bg-transparent transition-colors duration-300 ease-fluid hover:text-claro"
      >
        Privacidad
      </button>
      <button
        type="button"
        data-legal="terms"
        class="cursor-pointer text-sm text-claro/60 bg-transparent transition-colors duration-300 ease-fluid hover:text-claro"
      >
        Términos
      </button>
    </nav>

    <p class="text-sm text-claro/60">
      © {year} Marcos F. Zingaretti. Desarrollado en La Carlota, Córdoba, Argentina.
    </p>
  </div>
</footer>
