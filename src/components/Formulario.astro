<section id="formulario" class="p-auto m-auto p-8 max-w-md flex flex-col justify-center">
  <h3 class="flex text-4xl font-bold justify-center my-8 mx-auto px-8 border-2 rounded-full">Contacto</h3>
  <div class="max-w-sm mx-auto bg-white p-8 rounded-md shadow-md">
    <h2 class="text-2xl font-semibold mb-4">Formulario de Contacto</h2>
    <form class="flex flex-col m-auto" action="https://formspree.io/f/mwkddjvo" target="_blank" method="POST">
      <div class="mb-4">
        <input type="text" id="nombre" name="nombre" placeholder="Nombre" class="w-full border border-gray-300 p-2 rounded-md" />
      </div>
      <div class="mb-4">
        <input type="email" id="email" name="email" placeholder="Email" class="w-full border border-gray-300 p-2 rounded-md" />
      </div>
      <div class="mb-4">
        <input type="tel" id="telefono" name="telefono" placeholder="Teléfono" class="w-full border border-gray-300 p-2 rounded-md" />
      </div>
      <div class="mb-4">
        <textarea id="mensaje" name="mensaje" placeholder="Mensaje" rows="2" class="w-full border border-gray-300 p-2 rounded-md"></textarea>
      </div>
      <button type="submit" class="bg-gray-800 text-white px-4 py-2 rounded-md">Enviar</button>
    </form>
  </div>
</section>
