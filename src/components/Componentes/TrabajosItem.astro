---
const { url, imagen, titulo, descripcion } = Astro.props;
---

<a href=`${url}` target="_blank">
  <div class="flex flex-col bg-gradient-to-t from-gray-700 to-transparent rounded-xl">
    <img
      class="hover:scale-105 hover:shadow-xl active:scale-95 active:shadow-lg transition-transform rounded-xl w-auto h-full"
      src=`/Images/${imagen}`
      alt=`${descripcion}`
    />
    <h4 class="font-bold text-xl text-center">{titulo}</h4>
    <p class="text-center text-sm">{descripcion}</p>
  </div>
</a>
