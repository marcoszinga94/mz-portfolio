---
import CallToActionButtons from "../ui/CallToActionButtons.astro";
---

<section
  id="inicio"
  class="flex flex-col justify-center lg:flex-row items-center gap-8 m-auto min-h-[75vh]"
>
  <img
    alt="Foto de Marcos Zingaretti, con estilo anime"
    src={"/Images/selfie.png"}
    width={540}
    height={720}
    loading="eager"
    class="rounded-full h-64 lg:h-96 w-auto object-cover flex-shrink-0"
  />
  <div class="flex flex-col gap-6 text-center lg:text-left">
    <h1 class="flex flex-col text-4xl lg:text-5xl text-acento font-bold mb-2">
      Marcos Federico
      <span class="text-6xl lg:text-7xl text-acento font-black">
        Zingaretti
      </span>
    </h1>
    <h2 class="text-xl lg:text-2xl text-claro font-semibold">
      Desarrollador Web Full-Stack
    </h2>
    <CallToActionButtons class="justify-center lg:justify-start" />
  </div>
</section>
