---
import { Image } from "astro:assets";
import SocialLinks from "../ui/socialLinks.astro";
import CallToActionButtons from "../ui/CallToActionButtons.astro";
---

<section
  id="inicio"
  class="relative flex min-h-[85vh] w-full items-center justify-center overflow-hidden"
>
  <!-- Elementos decorativos -->
  <div class="absolute top-20 left-10 w-24 h-24 bg-acento/10 rounded-full blur-lg"></div>
  <div class="absolute bottom-20 right-10 w-32 h-32 bg-acento/5 rounded-full blur-xl"></div>

  <!-- Contenido principal -->
  <div
    class="relative z-10 flex flex-col-reverse lg:flex-row items-center justify-center gap-12 px-auto max-w-7xl m-auto"
  >
    <div class="relative flex flex-col gap-6 text-center lg:text-left lg:w-1/2 z-10">
      <div class="space-y-3">
        <h1
          class="text-4xl lg:text-6xl font-bold bg-gradient-to-r from-acento to-medio bg-clip-text text-transparent"
        >
          Marcos Federico
          <span class="block text-5xl lg:text-7xl mt-2">Zingaretti</span>
        </h1>
        <h2 class="text-xl lg:text-2xl text-claro/80 font-medium">Desarrollador Web Full-Stack</h2>
      </div>

      <p class="text-claro/70 text-lg max-w-xl mx-auto lg:mx-0">
        Creando experiencias web únicas y funcionales con pasión por el código limpio y el diseño
        moderno.
      </p>

      <CallToActionButtons />
      <SocialLinks class="flex lg:hidden" />
    </div>

    <div class="lg:w-1/2 flex flex-col justify-center items-center">
      <Image
        alt="Foto de Marcos Zingaretti"
        src="/Images/selfie.webp"
        width={540}
        height={720}
        loading="eager"
        class="relative size-64 lg:size-96 rounded-full object-cover border-4 border-acento/30"
      />
      <SocialLinks class="hidden lg:flex" />
    </div>
  </div>
</section>
