---
import { Image } from "astro:assets";
import CallToActionButtons from "../ui/CallToActionButtons.astro";
import selfie from "../../assets/selfie.webp";
---

<section id="inicio" class="relative scroll-mt-28">
  <div class="grid items-center gap-12 lg:grid-cols-[1fr_auto] lg:gap-16">
    <div class="flex flex-col items-start gap-6" data-reveal>
      <h1 class="max-w-[680px] bg-gradient-to-r from-white to-hero-end bg-clip-text text-4xl font-extrabold text-transparent sm:text-5xl">
        Webs y sistemas a medida que convierten visitas en clientes
      </h1>

      <p class="max-w-[680px] text-lg leading-relaxed text-claro/70">
        Diseño y desarrollo sitios y plataformas para negocios que quieren vender más y ordenar su
        operación. Te acompaño de la idea al lanzamiento.
      </p>

      <CallToActionButtons />

      <p class="text-sm text-claro/60">
        6 sistemas en producción para clínicas, gimnasios y empresas del agro.
      </p>
    </div>

    <div class="flex justify-center lg:justify-end" data-reveal data-reveal-delay="150">
      <Image
        alt="Retrato de Marcos F. Zingaretti, desarrollador web"
        src={selfie}
        widths={[320, 480, 600]}
        sizes="(min-width: 1024px) 384px, 320px"
        loading="eager"
        fetchpriority="high"
        class="size-64 rounded-3xl border border-borde object-cover brightness-[0.95] saturate-[0.85] sm:size-80 lg:size-96"
      />
    </div>
  </div>
</section>
