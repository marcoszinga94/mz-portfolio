---
import { Image } from "astro:assets";
import data from "../../data/cv";
---

<section id="sobre-mi" class="relative py-20 overflow-hidden">
  <div class="container mx-auto px-6 relative">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-4xl font-bold text-center mb-12">
        <span class="bg-gradient-to-r from-acento to-medio bg-clip-text text-transparent">
          Sobre Mí
        </span>
      </h2>

      <div class="space-y-6 text-claro/80" data-aos="fade-up">
        {
          data.sobreMi.map((parrafo) => (
            <p class="leading-relaxed text-lg transition-all duration-300 hover:text-claro text-pretty">
              {parrafo}
            </p>
          ))
        }
      </div>

      <div
        class="mt-16 grid grid-cols-2 sm:grid-cols-3 lg:flex lg:flex-nowrap lg:justify-center gap-8"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        {
          data.habilidades.map((habilidad) => (
            <div class="flex flex-col group items-center gap-4">
              <Image
                width="64"
                height="64"
                src={`/Images/stacks/${habilidad.icon}.svg`}
                alt={`Icono de ${habilidad.nombre}`}
                class="size-16 m-auto object-contain transition-transform duration-300 group-hover:-rotate-6"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
