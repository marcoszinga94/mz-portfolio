---
import data from "../../data/cv";
import SectionHeading from "../ui/SectionHeading.astro";
import SectionLabel from "../ui/SectionLabel.astro";
---

<section id="sobre-mi" class="relative scroll-mt-28">
  <SectionHeading title="Cómo llegué hasta acá" />

  <div class="relative mt-12">
    <SectionLabel text="Sobre mí" />
    <div class="rounded-2xl border border-borde bg-superficie p-6 sm:p-8" data-reveal>
      <div class="space-y-5">
        {data.sobreMi.map((parrafo) => (
          <p class="text-lg leading-relaxed text-claro/80">{parrafo}</p>
        ))}
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-8">
        {data.habilidades.map((habilidad) => (
          <div class="flex flex-col items-center gap-2">
            <img
              src={`/Images/stacks/${habilidad.icon}.svg`}
              alt={`Logo de ${habilidad.nombre}`}
              width={48}
              height={48}
              loading="lazy"
              class="size-12 object-contain"
            />
            <span class="text-xs text-claro/60">{habilidad.nombre}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
