---
import data from "../../data/cv";
---

<section id="sobre-mi" class="relative scroll-mt-28">
  <div
    data-reveal
    class="grid gap-8 rounded-2xl border border-borde bg-superficie p-6 sm:p-8 lg:grid-cols-[1.5fr_1fr] lg:items-center"
  >
    <div class="space-y-4">
      <h2 class="text-xl font-bold">Sobre mí</h2>
      <p class="text-lg leading-relaxed text-claro/80">{data.sobreMiCorto}</p>
    </div>

    <div
      class="grid grid-cols-3 place-items-center gap-x-4 gap-y-5 sm:grid-cols-4"
      aria-label="Tecnologías con las que trabajo"
    >
      {data.habilidades.map((habilidad) => (
        <div class="flex flex-col items-center gap-2">
          <img
            src={`/Images/stacks/${habilidad.icon}.svg`}
            alt={`Logo de ${habilidad.nombre}`}
            width={40}
            height={40}
            loading="lazy"
            class="size-10 object-contain"
          />
          <span class="text-xs text-claro/60">{habilidad.nombre}</span>
        </div>
      ))}
    </div>
  </div>
</section>
