---
import data from "../../data/cv";
---

<section id="sobre-mi" class="relative py-20 overflow-hidden">
  <div class="container mx-auto px-6 relative">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-4xl font-bold text-center mb-12">
        <span
          class="bg-gradient-to-r from-acento to-medio bg-clip-text text-transparent"
        >
          Sobre Mí
        </span>
      </h2>

      <div class="space-y-6 text-claro/80" data-aos="fade-up">
        {
          data.sobreMi.map((parrafo) => (
            <p class="leading-relaxed text-lg transition-all duration-300 hover:text-claro text-pretty">
              {parrafo}
            </p>
          ))
        }
      </div>

      <div
        class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-8"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        {
          data.habilidades.map((habilidad) => (
            <div class="flex flex-col group text-center gap-4">
              <img
                src={`/Images/stacks/${habilidad.icon}.svg`}
                alt={`Icono de ${habilidad.nombre}`}
                class="size-16 m-auto object-contain transition-transform duration-300 group-hover:-rotate-6"
              />
              <h3 class="text-claro font-medium group-hover:text-acento transition-colors duration-300">
                {habilidad.nombre}
              </h3>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  [data-aos] {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }

  [data-aos].aos-animate {
    opacity: 1;
    transform: translateY(0);
  }

  [data-aos][data-aos-delay] {
    transition-delay: 0s;
  }

  [data-aos][data-aos-delay].aos-animate {
    transition-delay: var(--aos-delay);
  }
</style>

<script>
  // Intersection Observer for animation on scroll
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("aos-animate");
        }
      });
    },
    {
      threshold: 0.1,
    }
  );

  document.querySelectorAll("[data-aos]").forEach((element) => {
    const delay = element.getAttribute("data-aos-delay");
    if (delay) {
      (element as HTMLElement).style.setProperty("--aos-delay", `${delay}ms`);
    }
    observer.observe(element);
  });
</script>
