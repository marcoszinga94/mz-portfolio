---
import { Icon } from "astro-icon/components";
import data from "../../data/cv";
import SectionLabel from "../ui/SectionLabel.astro";
import WhatsAppButton from "../ui/WhatsAppButton.astro";

const email = data.socialLinks.find((s) => s.name === "Email")!;
---

<section id="contacto" class="relative scroll-mt-28">
  <div class="relative">
    <SectionLabel text="Contacto" />
    <div class="rounded-3xl border border-borde bg-superficie px-6 py-14 text-center sm:px-12">
      <h2 class="mx-auto max-w-[680px] text-3xl font-bold sm:text-4xl">
        Contame tu idea y te respondo en menos de 24 horas
      </h2>
      <p class="mx-auto mt-4 max-w-xl leading-relaxed text-claro/70">
        Sin costo y sin compromiso. Si preferís, también podés escribirme por correo o descargar mi
        CV.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <WhatsAppButton
          message="Hola Marcos, tengo un proyecto en mente y quiero pedirte un presupuesto."
          label="Hablar por WhatsApp"
        />

        <a
          href={`mailto:${email.url}`}
          class="inline-flex items-center gap-2 rounded-full border border-borde px-6 py-3 text-base font-semibold text-claro transition-colors duration-300 ease-fluid hover:border-acento hover:text-acento"
        >
          <Icon name="ph:envelope-simple" class="size-5" />
          Enviar un correo
        </a>
      </div>

      <a
        href="/CV_Marcos_Zingaretti.pdf"
        download="CV_Marcos_Zingaretti.pdf"
        class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-claro/50 transition-colors duration-300 ease-fluid hover:text-claro"
      >
        <Icon name="ph:download-simple" class="size-4" />
        Descargar CV
      </a>
    </div>
  </div>
</section>
