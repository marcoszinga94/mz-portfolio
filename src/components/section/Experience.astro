---
import Timeline from "../ui/timeline.astro";
import data from "../../data/cv";
---

<section id="trayectoria" class="relative py-20 overflow-hidden">
  <div class="container mx-auto px-6 relative">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-4xl font-bold inline-block bg-gradient-to-r from-acento to-medio bg-clip-text text-transparent"
        >
          Mi Trayectoria
        </h2>
        <p class="mt-4 text-claro/70">
          Un recorrido por mi experiencia profesional y formación académica
        </p>
      </div>

      <div class="relative">
        <!-- Decorative line -->
        <div
          class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-t from-transparent from-0% via-acento/60 via-20% via-acento/60 via-90% to-transparent to-96%"
        >
        </div>

        <ul class="relative space-y-8">
          {data.experiencias.map((experiencia) => <Timeline item={experiencia} />)}
        </ul>
      </div>
    </div>
  </div>
</section>
