---
import Timeline from "../ui/timeline.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import SectionLabel from "../ui/SectionLabel.astro";
import data from "../../data/cv";
---

<section id="trayectoria" class="relative scroll-mt-28">
  <SectionHeading
    title="Experiencia y formación"
    description="Un recorrido por mi experiencia profesional y mi formación académica."
  />

  <div class="relative mt-12">
    <SectionLabel text="Trayectoria" />
    <div class="rounded-2xl border border-borde bg-superficie p-6 sm:p-8" data-reveal>
      <ol class="space-y-10 border-l border-borde">
        {data.experiencias.map((experiencia) => (
          <Timeline item={experiencia} />
        ))}
      </ol>
    </div>
  </div>
</section>
