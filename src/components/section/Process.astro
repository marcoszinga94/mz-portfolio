---
import data from "../../data/cv";
import SectionHeading from "../ui/SectionHeading.astro";
import SectionLabel from "../ui/SectionLabel.astro";
---

<section id="proceso" class="relative scroll-mt-28">
  <SectionHeading
    title="Cómo trabajo"
    description="Un proceso simple y transparente, de la idea al lanzamiento."
  />

  <div class="relative mt-12">
    <SectionLabel text="Proceso" />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {data.proceso.map((step, index) => (
        <article
          data-reveal
          data-reveal-delay={index * 100}
          class="rounded-2xl border border-borde bg-superficie p-6"
        >
          <span class="grid size-10 place-items-center rounded-full border border-borde text-sm font-bold text-acento">
            {step.paso}
          </span>
          <h3 class="mt-5 text-lg font-bold">{step.titulo}</h3>
          <p class="mt-2 text-sm leading-relaxed text-claro/70">{step.descripcion}</p>
        </article>
      ))}
    </div>
  </div>
</section>
