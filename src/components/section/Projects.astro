---
import Card from "../ui/card.astro";
import data from "../../data/cv";

const BENTO_SIZES = ["large", "normal", "normal", "wide", "normal", "wide", "normal"] as const;
---

<section id="proyectos" class="relative py-20 overflow-hidden">
  <div class="container mx-auto px-6 relative">
    <div class="text-center mb-16">
      <h2
        class="text-4xl font-bold inline-block bg-gradient-to-r from-acento to-medio bg-clip-text text-transparent"
      >
        Proyectos Destacados
      </h2>
      <p class="mt-4 text-claro/70 max-w-2xl mx-auto">
        Explora algunos de mis trabajos más recientes donde combino diseño moderno con funcionalidad
      </p>

      <div class="flex justify-center items-center gap-3 mt-6">
        <button
          id="viewGrid"
          class="p-2 rounded-lg border border-claro/30 text-claro/70 hover:text-claro hover:border-acento transition-all duration-300 data-[active=true]:bg-acento/20 data-[active=true]:border-acento data-[active=true]:text-acento"
          data-active="true"
          aria-label="Vista cuadrícula"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
          </svg>
        </button>
        <button
          id="viewList"
          class="p-2 rounded-lg border border-claro/30 text-claro/70 hover:text-claro hover:border-acento transition-all duration-300 data-[active=true]:bg-acento/20 data-[active=true]:border-acento data-[active=true]:text-acento"
          data-active="false"
          aria-label="Vista lista"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
        </button>
        <button
          id="viewBento"
          class="p-2 rounded-lg border border-claro/30 text-claro/70 hover:text-claro hover:border-acento transition-all duration-300 data-[active=true]:bg-acento/20 data-[active=true]:border-acento data-[active=true]:text-acento"
          data-active="false"
          aria-label="Vista bento"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="3" y="3" width="10" height="8" rx="1"></rect>
            <rect x="15" y="3" width="6" height="4" rx="1"></rect>
            <rect x="15" y="9" width="6" height="6" rx="1"></rect>
            <rect x="3" y="13" width="10" height="8" rx="1"></rect>
          </svg>
        </button>
      </div>
    </div>

    <div id="projectsContainer" class="max-w-7xl mx-auto" data-view="grid">
      {
        data.proyectos.map((proyecto, index) => (
          <div
            data-index={index}
            data-aos="fade-up"
            data-aos-delay={index * 100}
            data-aos-duration="800"
            data-aos-easing="ease-out-back"
            class="hover:z-10 transition-all duration-300 hover:scale-[1.02] project-item"
          >
            <Card proyecto={proyecto} bentoSize={BENTO_SIZES[index]} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  #projectsContainer[data-view="grid"] {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
  }

  @media (min-width: 768px) {
    #projectsContainer[data-view="grid"] {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    #projectsContainer[data-view="grid"] {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  #projectsContainer[data-view="list"] {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  #projectsContainer[data-view="list"] .project-item {
    max-width: 100%;
  }

  #projectsContainer[data-view="bento"] {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 768px) {
    #projectsContainer[data-view="bento"] {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  #projectsContainer[data-view="grid"] .project-item,
  #projectsContainer[data-view="bento"] .project-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  #projectsContainer[data-view="bento"] .project-item {
    cursor: grab;
    user-select: none;
  }

  #projectsContainer[data-view="bento"] .project-item.dragging {
    opacity: 0.4;
    cursor: grabbing;
  }

  #projectsContainer[data-view="bento"] .project-item.drag-over {
    outline: 2px dashed #ff3b3b;
    outline-offset: -4px;
    border-radius: 16px;
  }

  @media (min-width: 768px) {
    #projectsContainer[data-view="bento"] .project-item.bento-large {
      grid-column: span 2;
      grid-row: span 2;
    }

    #projectsContainer[data-view="bento"] .project-item.bento-wide {
      grid-column: span 2;
    }

    #projectsContainer[data-view="bento"] .project-item.bento-tall {
      grid-row: span 2;
    }
  }

  @media (max-width: 767px) {
    #projectsContainer[data-view="bento"] {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    #projectsContainer[data-view="bento"] .project-item.bento-large,
    #projectsContainer[data-view="bento"] .project-item.bento-wide,
    #projectsContainer[data-view="bento"] .project-item.bento-tall {
      grid-column: span 1;
      grid-row: span 1;
    }
  }

  :global([data-view="list"] article) {
    flex-direction: row !important;
    max-height: none !important;
  }

  :global([data-view="list"] article > div:first-child) {
    width: 280px !important;
    min-width: 280px;
    height: auto !important;
  }

  :global([data-view="list"] article > div:first-child img) {
    height: 100% !important;
  }

  :global([data-view="list"] article > div:last-child) {
    padding: 1.25rem 1.5rem !important;
    height: auto !important;
    flex: 1;
  }

  :global([data-view="list"] .line-clamp-3) {
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  :global([data-view="list"] [class*="min-h-"]) {
    min-height: 0 !important;
    max-height: none !important;
    overflow: visible !important;
  }

  :global([data-view="list"] article > div:last-child > div:last-child) {
    margin-top: auto !important;
    padding-top: 0.75rem;
  }

  :global([data-view="list"] article > div:last-child > div:last-child .flex-wrap) {
    gap: 0.5rem !important;
  }

  @media (max-width: 640px) {
    :global([data-view="list"] article) {
      flex-direction: column !important;
    }

    :global([data-view="list"] article > div:first-child) {
      width: 100% !important;
      min-width: unset;
      height: 200px !important;
    }
  }
</style>

<script>
  const container = document.getElementById("projectsContainer");
  const gridBtn = document.getElementById("viewGrid");
  const listBtn = document.getElementById("viewList");
  const bentoBtn = document.getElementById("viewBento");

  const BENTO_SIZES = ["bento-large", "", "", "bento-wide", "", "bento-wide", ""];

  function applyBentoSizes() {
    if (!container) return;
    const items = [...container.querySelectorAll(".project-item")] as HTMLElement[];
    items.forEach((el, i) => {
      el.classList.remove("bento-large", "bento-wide", "bento-tall");
      el.draggable = true;
      if (BENTO_SIZES[i]) el.classList.add(BENTO_SIZES[i]);
    });
  }

  function removeBentoSizes() {
    if (!container) return;
    bentoDnDSetup = false;
    const items = [...container.querySelectorAll(".project-item")] as HTMLElement[];
    items.forEach((el) => {
      el.classList.remove("bento-large", "bento-wide", "bento-tall", "dragging", "drag-over");
      el.draggable = false;
    });
  }

  function getBentoOrder(): number[] {
    try {
      const stored = localStorage.getItem("bentoOrder");
      if (stored) return JSON.parse(stored) as number[];
    } catch { /* ignore */ }
    return [];
  }

  function saveBentoOrder() {
    if (!container) return;
    const items = [...container.querySelectorAll(".project-item")] as HTMLElement[];
    const order = items.map((el) => Number(el.dataset.index));
    localStorage.setItem("bentoOrder", JSON.stringify(order));
  }

  function reorderItems(order: number[]) {
    if (!container) return;
    const items = [...container.querySelectorAll(".project-item")] as HTMLElement[];
    const parent = container;
    order.forEach((idx) => {
      const el = items.find((item) => Number(item.dataset.index) === idx);
      if (el) parent.appendChild(el);
    });
    saveBentoOrder();
    applyBentoSizes();
  }

  function setView(view: string) {
    if (!container || !gridBtn || !listBtn || !bentoBtn) return;
    if (container.dataset.view === view) return;

    const items = [...container.querySelectorAll(".project-item")] as HTMLElement[];
    const oldRects = items.map((el) => el.getBoundingClientRect());

    container.dataset.view = view;
    gridBtn.dataset.active = String(view === "grid");
    listBtn.dataset.active = String(view === "list");
    bentoBtn.dataset.active = String(view === "bento");

    if (view === "bento") {
      const order = getBentoOrder();
      if (order.length === items.length) {
        reorderItems(order);
      } else {
        applyBentoSizes();
      }
      setupBentoDnD();
    } else {
      removeBentoSizes();
    }

    localStorage.setItem("projectsView", view);

    requestAnimationFrame(() => {
      items.forEach((el, i) => {
        const newRect = el.getBoundingClientRect();
        const dx = oldRects[i].left - newRect.left;
        const dy = oldRects[i].top - newRect.top;
        if (dx !== 0 || dy !== 0) {
          el.animate(
            [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: "translate(0, 0)" }],
            { duration: 400, easing: "ease" },
          );
        }
      });
    });
  }

  let dragSrcIndex: number | null = null;
  let bentoDnDSetup = false;

  function getItemFromEvent(e: Event): HTMLElement | null {
    return (e.target as HTMLElement)?.closest(".project-item") as HTMLElement | null;
  }

  function handleDragStart(e: Event) {
    const el = getItemFromEvent(e);
    if (!el) return;
    dragSrcIndex = Number(el.dataset.index);
    el.classList.add("dragging");
    const dt = (e as DragEvent).dataTransfer;
    if (dt) {
      dt.effectAllowed = "move";
      dt.setData("text/plain", String(dragSrcIndex));
    }
  }

  function handleDragEnd(_e: Event) {
    if (!container) return;
    const items = [...container.querySelectorAll(".project-item")] as HTMLElement[];
    items.forEach((el) => el.classList.remove("dragging", "drag-over"));
    dragSrcIndex = null;
  }

  function handleDragOver(e: Event) {
    const el = getItemFromEvent(e);
    if (!el) return;
    e.preventDefault();
    const dt = (e as DragEvent).dataTransfer;
    if (dt) dt.dropEffect = "move";
    el.classList.add("drag-over");
  }

  function handleDragLeave(e: Event) {
    const el = getItemFromEvent(e);
    if (!el) return;
    el.classList.remove("drag-over");
  }

  function handleDrop(e: Event) {
    e.preventDefault();
    const target = getItemFromEvent(e);
    if (!target || !container) return;
    target.classList.remove("drag-over");

    const targetIndex = Number(target.dataset.index);
    if (dragSrcIndex === null || dragSrcIndex === targetIndex) return;

    const items = [...container.querySelectorAll(".project-item")] as HTMLElement[];
    const order = items.map((el) => Number(el.dataset.index));
    const srcPos = order.indexOf(dragSrcIndex);
    const tgtPos = order.indexOf(targetIndex);
    if (srcPos === -1 || tgtPos === -1) return;

    order.splice(srcPos, 1);
    order.splice(tgtPos, 0, dragSrcIndex);
    reorderItems(order);
  }

  function setupBentoDnD() {
    if (bentoDnDSetup || !container) return;
    bentoDnDSetup = true;
    container.addEventListener("dragstart", handleDragStart);
    container.addEventListener("dragend", handleDragEnd);
    container.addEventListener("dragover", handleDragOver);
    container.addEventListener("dragleave", handleDragLeave);
    container.addEventListener("drop", handleDrop);
  }

  gridBtn?.addEventListener("click", () => setView("grid"));
  listBtn?.addEventListener("click", () => setView("list"));
  bentoBtn?.addEventListener("click", () => setView("bento"));

  const saved = localStorage.getItem("projectsView");
  if (container && gridBtn && listBtn && bentoBtn) {
    if (saved === "grid" || saved === "list" || saved === "bento") {
      container.dataset.view = saved;
      gridBtn.dataset.active = String(saved === "grid");
      listBtn.dataset.active = String(saved === "list");
      bentoBtn.dataset.active = String(saved === "bento");
      if (saved === "bento") {
        const order = getBentoOrder();
        const items = [...container.querySelectorAll(".project-item")] as HTMLElement[];
        if (order.length === items.length) {
          reorderItems(order);
        } else {
          applyBentoSizes();
        }
        setupBentoDnD();
      }
    }
  }
</script>
