---
import Card from "../ui/card.astro";

const PROYECTOS = [
  {
    nombre: "Argentista",
    enlace: "https://argentista.vercel.app",
    imagen: "argentista",
    descripcion:
      "Aplicación interactiva que utiliza APIs para mostrar datos económicos de Argentina.",
    tecnologias: ["Astro", "React", "Tailwind", "JavaScript"],
    caracteristicas: [
      "Integración con APIs",
      "Visualización de datos mediante gráficas",
      "Diseño responsivo adaptado a diversos dispositivos",
    ],
    categoria: "Economía",
  },
  {
    nombre: "Tasador de Propiedades",
    enlace: "https://argensador.vercel.app/",
    imagen: "tasador",
    descripcion:
      "Aplicación interactiva que se usa para cotizar/tasar propiedades, de uso privado.",
    tecnologias: ["Astro", "React", "Tailwind", "JavaScript"],
    caracteristicas: [
      "Servicio privado para inmobiliaria con autenticación",
      "Calcular valor de propiedades con depreciacion",
      "Opción para guardar y gestionar tasaciones previas",
    ],
    categoria: "Herramientas",
  },
  {
    nombre: "El Socorro SRL",
    enlace: "https://elsocorrosrl.com/",
    imagen: "elsocorro",
    descripcion:
      "Landing page diseñada para una empresa de servicios agrícolas. Destinada a presentar la empresa y contactar.",
    tecnologias: ["Astro", "Tailwind", "JavaScript"],
    repositorio: "https://github.com/marcoszinga94/LandingAgro",
    caracteristicas: [
      "Diseño tradicional y elegante",
      "Diseño responsivo para diferentes dispositivos",
      "Formulario de contacto para consultas",
    ],
    categoria: "Landing Page",
  },
];
---

<section id="proyectos" class="max-w-screen-md mx-auto">
  <h3 class="text-4xl font-bold text-center mb-12 text-acento">
    Proyectos Destacados
  </h3>
  {
    PROYECTOS && PROYECTOS.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {PROYECTOS.map((proyecto: any, index: any) => (
          <Card
            proyecto={proyecto}
            isFeatured={index === 0}
            key={proyecto.nombre}
          />
        ))}
      </div>
    ) : (
      <p class="text-center text-claro">No hay proyectos para mostrar.</p>
    )
  }
</section>
