---
import Card from "../ui/card.astro";
import data from "../../data/cv";
---

<section id="proyectos" class="relative py-20 overflow-hidden">
  <div class="container mx-auto px-6 relative">
    <div class="text-center mb-16">
      <h2
        class="text-4xl font-bold inline-block bg-gradient-to-r from-acento to-medio bg-clip-text text-transparent"
      >
        Proyectos Destacados
      </h2>
      <p class="mt-4 text-claro/70 max-w-2xl mx-auto">
        Explora algunos de mis trabajos más recientes donde combino diseño
        moderno con funcionalidad
      </p>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto"
    >
      {
        data.proyectos.map((proyecto, index) => (
          <div
            data-aos="fade-up"
            data-aos-delay={index * 100}
            data-aos-duration="800"
            data-aos-easing="ease-out-back"
            class="hover:z-10 transition-all duration-300 hover:scale-[1.02] h-full flex flex-col"
          >
            <Card proyecto={proyecto} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  [data-aos] {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }

  [data-aos].aos-animate {
    opacity: 1;
    transform: translateY(0);
  }

  [data-aos][data-aos-delay] {
    transition-delay: 0s;
  }

  [data-aos][data-aos-delay].aos-animate {
    transition-delay: var(--aos-delay);
  }
</style>

<script>
  // Intersection Observer for animation on scroll
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("aos-animate");
        }
      });
    },
    {
      threshold: 0.1,
    },
  );

  document.querySelectorAll("[data-aos]").forEach((element) => {
    const delay = element.getAttribute("data-aos-delay");
    if (delay) {
      (element as HTMLElement).style.setProperty("--aos-delay", `${delay}ms`);
    }
    observer.observe(element);
  });
</script>
