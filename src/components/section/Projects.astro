---
import Card from "../ui/card.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import SectionLabel from "../ui/SectionLabel.astro";
import WhatsAppButton from "../ui/WhatsAppButton.astro";
import data from "../../data/cv";
---

<section id="proyectos" class="relative scroll-mt-28">
  <SectionHeading
    title="Sistemas y webs que ya están funcionando"
    description="Una selección de trabajos reales en clínicas, gimnasios, agro y gestión."
  />

  <div class="relative mt-12">
    <SectionLabel text="Proyectos" />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {data.proyectos.map((proyecto, index) => (
        <div data-reveal data-reveal-delay={(index % 3) * 100}>
          <Card proyecto={proyecto} />
        </div>
      ))}
    </div>

    <div
      data-reveal
      class="mt-12 flex flex-col items-center gap-5 rounded-2xl border border-borde bg-superficie p-8 text-center"
    >
      <p class="text-lg font-semibold">¿Querés una web o un sistema así para tu negocio?</p>
      <WhatsAppButton label="Pedir presupuesto" />
    </div>
  </div>
</section>
