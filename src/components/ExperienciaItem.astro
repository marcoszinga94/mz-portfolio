---
const { fecha, titulo, descripcion } = Astro.props;
---

<div class="absolute w-3 h-3 bg-gray-500 rounded-full mt-1.5 -start-1.5 border border-white"></div>
  <time class="mb-1 text-sm font-bold leading-none text-gray-400">{fecha}</time>
  <h3 class="text-lg font-semibold text-[#f50000]">{titulo}</h3>
  <p class="mx-4 mb-4 text-base font-light text-gray-500">{descripcion}</p>

