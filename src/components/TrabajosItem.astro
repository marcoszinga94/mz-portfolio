---
const { url, imagen, titulo, descripcion } = Astro.props;
---

<div class="flex flex-col gap-4">
  <a href=`${url}` target="_blank">
    <div class="flex flex-col bg-gradient-to-t from-gray-500 to-transparent rounded-b-xl">
      <img class="hover:scale-90 transition-transform rounded-xl" src=`/Images/${imagen}` alt="" />
      <h4 class="font-bold text-3xl text-center">{titulo}</h4>
      <p class="text-center text-xl">{descripcion}</p>
    </div>
  </a>
</div>
