---
interface Props {
  variant?: "primary" | "secondary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  isFullWidth?: boolean;
  isLoading?: boolean;
  loadingText?: string;
  icon?: string;
  class?: string;
  onclick?: string;
  [key: string]: any;
}

const {
  variant = "primary",
  size = "md",
  isFullWidth = false,
  isLoading = false,
  loadingText,
  icon,
  class: className,
  ...rest
} = Astro.props;

const variants: Record<Required<Props>["variant"], string> = {
  primary:
    "bg-gradient-to-r from-acento to-medio text-claro hover:from-medio hover:to-acento",
  secondary: "bg-medio/10 text-medio hover:bg-medio/20",
  outline: "border-2 border-acento text-acento hover:bg-acento/10",
  ghost: "text-claro/70 hover:text-acento hover:bg-acento/10",
};

const sizes: Record<Required<Props>["size"], string> = {
  sm: "px-3 py-1.5 text-sm",
  md: "px-4 py-2 text-base",
  lg: "px-6 py-3 text-lg",
};

const baseStyles = `
  inline-flex items-center justify-center
  rounded-lg font-medium
  transition-all duration-300 ease-in-out
  focus:outline-none focus-visible:ring-2 focus-visible:ring-acento focus-visible:ring-offset-2 focus-visible:ring-offset-fondo
  disabled:opacity-50 disabled:cursor-not-allowed
  transform hover:scale-[1.02] active:scale-[0.98]
`;
---

<button
  class:list={[
    baseStyles,
    variants[variant],
    sizes[size],
    isFullWidth && "w-full",
    className,
  ]}
  disabled={isLoading}
  {...rest}
>
  {
    isLoading && (
      <div class="mr-2 animate-spin">
        <svg
          class="w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
        >
          <circle
            class="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="4"
          />
          <path
            class="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
          />
        </svg>
      </div>
    )
  }

  {
    icon && !isLoading && (
      <span class="mr-2">
        <svg
          class="w-5 h-5"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d={icon} />
        </svg>
      </span>
    )
  }

  <span class={isLoading ? "opacity-75" : ""}>
    {isLoading ? loadingText || <slot /> : <slot />}
  </span>

  {
    variant === "primary" && (
      <div class="absolute inset-0 rounded-lg bg-gradient-to-r from-acento to-medio opacity-0 group-hover:opacity-10 transition-opacity duration-300" />
    )
  }
</button>

<style>
  button {
    position: relative;
    overflow: hidden;
  }

  button::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: background-color 0.3s ease;
    mix-blend-mode: overlay;
  }

  button:hover::after {
    background-color: rgba(255, 255, 255, 0.1);
  }

  button:active::after {
    background-color: rgba(0, 0, 0, 0.1);
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transform: none !important;
      transition: none !important;
    }
  }
</style>
