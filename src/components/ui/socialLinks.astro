---
import type { SocialLink } from "../../types";
import data from "../../data/cv";

const socialLinks: SocialLink[] = data.socialLinks;

interface Props {
  class: string;
}
const { class: className } = Astro.props;
---

<div class={`m-4 justify-center space-x-6 ${className}`}>
  {
    socialLinks.map(({ name, url, icon }) => (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-claro/70 hover:text-acento transition-colors duration-300 group"
      >
        <svg
          class="size-8 lg:size-10 fill-current transform transition-transform duration-300 group-hover:scale-110"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d={icon} />
        </svg>
      </a>
    ))
  }
</div>
