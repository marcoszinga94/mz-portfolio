---
import { Image } from "astro:assets";
import type { Proyecto } from "../../types/index.ts";

interface Props {
  proyecto: Proyecto;
}

const { proyecto } = Astro.props;
---

<a
  href={proyecto.enlace}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "group block relative overflow-hidden",
    "col-span-1 md:col-span-2",
  ]}
>
  <article
    class:list={[
      "relative bg-gradient-to-br from-gray-custom to-fondo rounded-2xl overflow-hidden shadow-lg transition-all duration-500",
      "hover:shadow-2xl hover:shadow-acento/20 hover:translate-y-[-4px] hover:scale-[1.01] md:grid md:grid-cols-2 flex flex-col h-full",
    ]}
  >
    <div class:list={["relative overflow-hidden", "h-full"]}>
      <Image
        src={`/Images/paginas/${proyecto.imagen}.webp`}
        alt={`Vista previa del proyecto ${proyecto.nombre}: ${proyecto.descripcion}`}
        width={533}
        height={830}
        class="w-full h-full object-cover object-top"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-fondo/90 via-fondo/50 to-transparent opacity-0 group-hover:opacity-70 transition-all duration-500"
      >
      </div>
    </div>

    <div
      class="flex flex-col p-6 gap-6 flex-grow bg-gradient-to-br from-gray-custom/50 to-fondo/50 backdrop-blur-sm"
    >
      <div class="flex flex-col gap-3">
        <h3
          class="font-bold text-2xl bg-gradient-to-r from-acento to-medio bg-clip-text text-transparent group-hover:from-medio group-hover:to-acento transition-all duration-500"
        >
          {proyecto.nombre}
        </h3>
        <p
          class="text-claro/80 leading-relaxed group-hover:text-claro transition-colors duration-300"
        >
          {proyecto.descripcion}
        </p>
      </div>

      {
        proyecto.caracteristicas && (
          <div class="flex flex-col gap-3">
            <p class="font-semibold text-medio">Características:</p>
            <ul class="space-y-2">
              {proyecto.caracteristicas.map((caracteristica: string) => (
                <li class="flex items-center gap-2 text-claro/70 group-hover:text-claro/90 transition-colors duration-300">
                  <span class="text-acento group-hover:text-medio transition-colors duration-300">
                    ▹
                  </span>
                  {caracteristica}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        proyecto.tecnologias && (
          <div class="flex flex-col gap-3 mt-auto pt-4 border-t border-acento/20">
            <p class="text-sm text-medio/80">Tecnologías:</p>
            <div class="flex flex-wrap gap-4">
              {proyecto.tecnologias.map((stack: string) => (
                <div class="group/icon">
                  <img
                    src={`/Images/stacks/${stack}.svg`}
                    alt={`Icono de ${stack}`}
                    width={32}
                    height={32}
                    loading="lazy"
                    class="w-8 h-8 transition-all duration-300 group-hover/icon:scale-125 group-hover/icon:rotate-6 group-hover/icon:drop-shadow-[0_0_8px_rgba(255,59,59,0.5)]"
                  />
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </article>
</a>
