---
import { Icon } from "astro-icon/components";
import type { Proyecto } from "../../types/index.ts";

interface Props {
  proyecto: Proyecto;
}

const { proyecto } = Astro.props;
---

<a
  href={proyecto.enlace}
  target="_blank"
  rel="noopener noreferrer"
  class="group block h-full"
  aria-label={`Ver el proyecto ${proyecto.nombre}`}
>
  <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-borde bg-superficie transition-colors duration-500 ease-fluid hover:border-acento/50">
    <div class="relative h-48 overflow-hidden">
      <img
        src={`/Images/paginas/${proyecto.imagen}.webp`}
        alt={`Vista previa del proyecto ${proyecto.nombre}`}
        width={711}
        height={400}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-center transition-transform duration-700 ease-fluid group-hover:scale-105"
      />
    </div>

    <div class="flex flex-1 flex-col p-6">
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-xl font-bold">{proyecto.nombre}</h3>
        <Icon
          name="ph:arrow-up-right"
          class="mt-1 size-5 shrink-0 text-claro/40 transition-colors duration-300 ease-fluid group-hover:text-acento"
        />
      </div>

      <p class="mt-2 text-sm leading-relaxed text-claro/70">{proyecto.descripcion}</p>

      {proyecto.tecnologias && (
        <div class="mt-auto flex flex-wrap items-center gap-3 pt-6">
          {proyecto.tecnologias.map((stack: string) => (
            <img
              src={`/Images/stacks/${stack}.svg`}
              alt={stack}
              title={stack}
              width={24}
              height={24}
              loading="lazy"
              class="size-6 transition-transform duration-300 ease-fluid group-hover:scale-110"
            />
          ))}
        </div>
      )}
    </div>
  </article>
</a>
