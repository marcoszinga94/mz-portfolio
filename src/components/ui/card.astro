---
import { Image } from "astro:assets";
import type { Proyecto } from "../../types/index.ts";

interface Props {
  proyecto: Proyecto;
}

const { proyecto } = Astro.props;
---

<a
  href={proyecto.enlace}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "group block relative overflow-hidden",
    "p-2",
    "h-full"
  ]}
>
  <article
    class:list={[
      "relative bg-gradient-to-br from-gray-custom to-fondo rounded-2xl overflow-hidden shadow-lg transition-all duration-500",
      "hover:translate-y-[-4px] hover:scale-[1.01] hover:bg-gradient-to-br hover:from-gray-custom/90 hover:to-fondo/90",
      "flex flex-col h-full min-h-[400px] md:min-h-[500px]",
      "transform-gpu will-change-transform",
      "w-full",
    ]}
  >
    <div class:list={["relative overflow-hidden", "h-[200px] md:h-[220px] lg:h-[240px]"]}>
      <Image
        src={`/Images/paginas/${proyecto.imagen}.webp`}
        alt={`Vista previa del proyecto ${proyecto.nombre}: ${proyecto.descripcion}`}
        width={533}
        height={830}
        class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
      />
    </div>

    <div
      class="flex flex-col p-6 gap-4 flex-grow bg-gradient-to-br from-gray-custom/50 to-fondo/50 backdrop-blur-sm h-[calc(100%-200px)] md:h-[calc(100%-220px)] lg:h-[calc(100%-240px)]"
    >
      <div class="flex flex-col gap-3">
        <h3
          class="font-bold text-xl md:text-2xl bg-gradient-to-r from-acento to-medio bg-clip-text text-transparent group-hover:from-medio group-hover:to-acento transition-all duration-500"
        >
          {proyecto.nombre}
        </h3>
        <p
          class="text-claro/80 leading-relaxed group-hover:text-claro transition-colors duration-300 line-clamp-3 min-h-[4.5rem]"
        >
          {proyecto.descripcion}
        </p>
      </div>

      {
        proyecto.caracteristicas && (
          <div class="flex flex-col gap-3">
            <p class="font-semibold text-medio">Características:</p>
            <ul class="space-y-2 min-h-[100px] max-h-[150px] overflow-y-auto">
              {proyecto.caracteristicas.map((caracteristica: string) => (
                <li class="flex items-center gap-2 text-claro/70 group-hover:text-claro/90 transition-colors duration-300">
                  <span class="text-acento group-hover:text-medio transition-colors duration-300">
                    ▹
                  </span>
                  {caracteristica}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        proyecto.tecnologias && (
          <div class="flex flex-col gap-3 mt-auto pt-4 border-t border-acento/20 min-h-[80px]">
            <p class="text-sm text-medio/80">Tecnologías:</p>
            <div class="flex flex-wrap gap-4">
              {proyecto.tecnologias.map((stack: string) => (
                <div class="group/icon">
                  <img
                    src={`/Images/stacks/${stack}.svg`}
                    alt={`Icono de ${stack}`}
                    width={32}
                    height={32}
                    loading="lazy"
                    class="w-8 h-8 transition-all duration-300 group-hover/icon:scale-125 group-hover/icon:rotate-6 group-hover/icon:drop-shadow-[0_0_8px_rgba(255,59,59,0.5)]"
                  />
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </article>
</a>
