---
import { Image } from "astro:assets";
import type { Proyecto } from "../../types/index.ts";

interface Props {
  proyecto: Proyecto;
}

const { proyecto } = Astro.props;
---

<a
  href={proyecto.enlace}
  target="_blank"
  rel="noopener noreferrer"
  draggable="false"
  class="group block relative overflow-hidden p-2 h-full"
>
  <article
    data-has-long={proyecto.descripcionLarga ? "" : undefined}
    class="relative bg-linear-to-br from-gray-custom to-fondo rounded-2xl overflow-hidden shadow-lg transition-all duration-500 hover:translate-y-[-4px] hover:scale-[1.01] hover:bg-linear-to-br hover:from-gray-custom/90 hover:to-fondo/90 flex flex-col h-full min-h-[420px] transform-gpu will-change-transform w-full"
  >
    <div class="relative overflow-hidden shrink-0 h-[200px]">
      <Image
        src={`/Images/paginas/${proyecto.imagen}.webp`}
        alt={`Vista previa del proyecto ${proyecto.nombre}: ${proyecto.descripcion}`}
        width={533}
        height={830}
        class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
      />
    </div>

    <div class="flex flex-col p-6 gap-2 grow bg-linear-to-br from-gray-custom/50 to-fondo/50 backdrop-blur-sm overflow-hidden min-h-0">
      <div class="content-inner flex flex-col gap-2 min-h-0 grow">
        <div class="flex flex-col gap-2">
          <h3 class="font-bold text-xl md:text-2xl bg-linear-to-r from-acento to-medio bg-clip-text text-transparent group-hover:from-medio group-hover:to-acento transition-all duration-500">
            {proyecto.nombre}
          </h3>

          <div class="flex flex-col gap-1">
            <p class="desc-short line-clamp-2 text-claro/80 leading-relaxed group-hover:text-claro transition-colors duration-300">
              {proyecto.descripcion}
            </p>
            {proyecto.descripcionLarga && (
              <p class="desc-long hidden text-claro/80 leading-relaxed group-hover:text-claro transition-colors duration-300">
                {proyecto.descripcionLarga}
              </p>
            )}
          </div>
        </div>

      {proyecto.tecnologias && (
        <div class="flex flex-col gap-2 pt-3 border-t border-acento/20 mt-auto">
          <p class="text-xs text-medio/70">Tecnologías:</p>
          <div class="flex flex-wrap gap-3">
            {proyecto.tecnologias.map((stack: string) => (
              <div class="group/icon">
                <img
                  src={`/Images/stacks/${stack}.svg`}
                  alt={`Icono de ${stack}`}
                  width={28}
                  height={28}
                  loading="lazy"
                  class="w-7 h-7 transition-all duration-300 group-hover/icon:scale-125 group-hover/icon:rotate-6 group-hover/icon:drop-shadow-[0_0_8px_rgba(255,59,59,0.5)]"
                />
              </div>
            ))}
          </div>
        </div>
      )}
      </div>
    </div>
  </article>
</a>