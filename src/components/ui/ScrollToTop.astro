---
import { Icon } from "astro-icon/components";
---

<button
  id="scroll-to-top"
  type="button"
  aria-label="Volver al inicio"
  class="pointer-events-none fixed bottom-8 right-8 z-50 grid size-11 translate-y-20 place-items-center rounded-full border border-borde bg-superficie text-claro opacity-0 transition-all duration-500 ease-fluid hover:border-acento hover:text-acento"
>
  <Icon name="ph:arrow-up" class="size-5" />
</button>

<script>
  const scrollBtn = document.getElementById("scroll-to-top");
  const sentinel = document.getElementById("scroll-sentinel");

  if (scrollBtn && sentinel) {
    const observer = new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting;
      scrollBtn.classList.toggle("translate-y-20", !show);
      scrollBtn.classList.toggle("opacity-0", !show);
      scrollBtn.classList.toggle("pointer-events-none", !show);
    });

    observer.observe(sentinel);

    scrollBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }
</script>
