---
import { Icon } from "astro-icon/components";
import data from "../../data/cv";

const whatsapp = data.socialLinks.find((s) => s.name === "WhatsApp")!;
const url = `${whatsapp.url}?text=${encodeURIComponent(
  "Hola Marcos, quiero un presupuesto para mi proyecto.",
)}`;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar por WhatsApp"
  class="fixed bottom-6 left-6 z-50 grid size-14 place-items-center rounded-full bg-acento text-white shadow-lg transition-transform duration-300 ease-fluid hover:scale-110 active:scale-95"
>
  <Icon name="ph:whatsapp-logo" class="size-7" />
</a>
