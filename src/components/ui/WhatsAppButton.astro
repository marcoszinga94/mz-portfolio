---
import { Icon } from "astro-icon/components";
import data from "../../data/cv";

interface Props {
  message?: string;
  label?: string;
  className?: string;
}

const {
  message = "Hola Marcos, quiero un presupuesto para mi proyecto.",
  label = "Pedir presupuesto",
  className = "",
} = Astro.props;

const whatsapp = data.socialLinks.find((s) => s.name === "WhatsApp")!;
const url = `${whatsapp.url}?text=${encodeURIComponent(message)}`;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class={`inline-flex items-center justify-center gap-2 rounded-full bg-acento px-6 py-3 text-base font-semibold text-white transition-transform duration-300 ease-fluid hover:scale-[1.03] active:scale-[0.98] ${className}`}
>
  <Icon name="ph:whatsapp-logo" class="size-5" />
  {label}
</a>
