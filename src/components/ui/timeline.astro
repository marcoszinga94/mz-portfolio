---
import type { TimelineItem } from "../../types";

interface Props {
  item: TimelineItem;
}

const { item } = Astro.props;
---

<li class="relative pl-8">
  <span class="absolute left-0 top-2 size-3 -translate-x-1/2 rounded-full bg-acento ring-4 ring-superficie"></span>

  <time class="text-sm font-medium text-claro/60">{item.fecha}</time>
  <h3 class="mt-1 text-lg font-bold">{item.titulo}</h3>
  <p class="mt-1 leading-relaxed text-claro/70">{item.descripcion}</p>
</li>
