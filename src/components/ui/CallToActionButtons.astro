---
import { Icon } from "astro-icon/components";
import WhatsAppButton from "./WhatsAppButton.astro";
---

<div class="flex flex-wrap items-center gap-4">
  <WhatsAppButton label="Pedir presupuesto" />

  <a
    href="#proyectos"
    class="inline-flex items-center gap-2 rounded-full border border-borde px-6 py-3 text-base font-semibold text-claro transition-colors duration-300 ease-fluid hover:border-acento hover:text-acento"
  >
    Ver proyectos
    <Icon name="ph:arrow-right" class="size-5" />
  </a>
</div>
