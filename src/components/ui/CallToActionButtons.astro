---
import Button from "./button.astro";

interface Props {
  showResume?: boolean;
  showContact?: boolean;
  class?: string;
}

const { showResume = true, showContact = true, class: className } = Astro.props;

const downloadIcon =
  "M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4";
const mailIcon =
  "M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22,6l-10,7L2,6";
---

<div class:list={["flex flex-wrap gap-4", className]}>
  {
    showResume && (
      <Button
        variant="primary"
        size="lg"
        icon={downloadIcon}
        class="group"
        onclick="window.open('/CV_Marcos_Zingaretti.pdf', '_blank')"
      >
        Descargar CV
      </Button>
    )
  }

  {
    showContact && (
      <Button
        variant="outline"
        size="lg"
        icon={mailIcon}
        class="group"
        onclick="window.location.href='mailto:tu-email@example.com'"
      >
        Contáctame
      </Button>
    )
  }
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const handleButtonClick = (event: MouseEvent) => {
      const target = event.currentTarget as HTMLButtonElement;

      // Añadir efecto de ripple
      const ripple = document.createElement("div");
      const rect = target.getBoundingClientRect();

      ripple.style.position = "absolute";
      ripple.style.borderRadius = "50%";
      ripple.style.backgroundColor = "rgba(255, 255, 255, 0.3)";
      ripple.style.width = ripple.style.height = "100px";
      ripple.style.transform = "translate(-50%, -50%) scale(0)";
      ripple.style.animation = "ripple 600ms linear";

      ripple.style.left = event.clientX - rect.left + "px";
      ripple.style.top = event.clientY - rect.top + "px";

      target.appendChild(ripple);

      ripple.addEventListener("animationend", () => {
        ripple.remove();
      });
    };

    document.querySelectorAll("button").forEach((button) => {
      button.addEventListener("click", handleButtonClick);
    });
  });
</script>

<style>
  @keyframes ripple {
    to {
      transform: translate(-50%, -50%) scale(4);
      opacity: 0;
    }
  }

  /* Mejoras de accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    button {
      animation: none !important;
    }
  }

  /* Soporte para navegación con teclado */
  button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
