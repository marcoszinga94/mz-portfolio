---
import data from "../../data/cv";

const email = data.socialLinks.find((s) => s.name === "Email")!;
const whatsapp = data.socialLinks.find((s) => s.name === "WhatsApp")!;
const github = data.socialLinks.find((s) => s.name === "GitHub")!;
---

  <div class="flex flex-row flex-wrap gap-4 justify-center lg:justify-start">
  <a
    class="px-4 py-2 text-base inline-flex items-center justify-center rounded-lg font-medium transition-all duration-300 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-acento focus-visible:ring-offset-2 focus-visible:ring-offset-fondo disabled:opacity-50 disabled:cursor-not-allowed transform hover:scale-[1.02] active:scale-[0.98] border-2 border-acento text-acento hover:bg-acento/10"
    href={`mailto:${email.url}`}
  >
    <span class="mr-2">
      <svg
        class="size-auto"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d={email.icon}></path>
      </svg>
    </span>
    Email
  </a>

  <a
    class="px-4 py-2 text-base inline-flex items-center justify-center rounded-lg font-medium transition-all duration-300 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-acento focus-visible:ring-offset-2 focus-visible:ring-offset-fondo disabled:opacity-50 disabled:cursor-not-allowed transform hover:scale-[1.02] active:scale-[0.98] border-2 border-acento text-acento hover:bg-acento/10"
    href={whatsapp.url}
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="mr-2">
      <svg
        class="size-auto"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 20 20"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d={whatsapp.icon}></path>
      </svg>
    </span>
    WhatsApp
  </a>

  <a
    href={github.url}
    target="_blank"
    rel="noopener noreferrer"
    class="px-4 py-2 text-base inline-flex items-center justify-center rounded-lg font-medium transition-all duration-300 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-acento focus-visible:ring-offset-2 focus-visible:ring-offset-fondo disabled:opacity-50 disabled:cursor-not-allowed transform hover:scale-[1.02] active:scale-[0.98] border-2 border-acento text-acento hover:bg-acento/10"
    aria-label="GitHub"
  >
    <span class="mr-2">
      <svg
        class="size-6 fill-current"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d={github.icon} />
      </svg>
    </span>
    GitHub
  </a>

  <a
    class="px-4 py-2 text-base inline-flex items-center justify-center rounded-lg font-medium transition-all duration-300 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-acento focus-visible:ring-offset-2 focus-visible:ring-offset-fondo disabled:opacity-50 disabled:cursor-not-allowed transform hover:scale-[1.02] active:scale-[0.98] bg-gradient-to-r from-acento to-medio text-claro hover:from-medio hover:to-acento"
    href="/CV_Marcos_Zingaretti.pdf"
    download="CV_Marcos_Zingaretti.pdf"
  >
    <span class="mr-2">
      <svg
        class="size-auto"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
      </svg>
    </span>
    CV
  </a>
</div>
