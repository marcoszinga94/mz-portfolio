---
import { Icon } from "astro-icon/components";
import { legalDocuments } from "../../data/legal";
---

<dialog
  id="legal-dialog"
  class="w-full max-w-2xl rounded-2xl border border-borde bg-superficie p-0 text-claro"
>
  <div id="legal-scroll" class="max-h-[80vh] overflow-y-auto p-6 sm:p-8">
    <div class="flex items-start justify-between gap-4">
      <h2 id="legal-dialog-title" class="text-2xl font-bold text-claro">
        Documento legal
      </h2>
      <form method="dialog">
        <button
          type="submit"
          class="grid size-9 shrink-0 place-items-center rounded-full border border-borde text-claro/60 transition-colors duration-300 ease-fluid hover:border-acento hover:text-claro"
          aria-label="Cerrar"
        >
          <Icon name="ph:x" class="size-5" />
        </button>
      </form>
    </div>
    <p id="legal-dialog-updated" class="mt-1 text-sm text-claro/50"></p>

    {legalDocuments.map((doc) => (
      <div
        data-legal-block={doc.id}
        data-title={doc.title}
        data-updated={doc.updated}
        hidden={doc.id === "terms"}
      >
        <div class="mt-6 space-y-6">
          {doc.sections.map((section) => (
            <section>
              <h3 class="text-lg font-semibold text-claro">{section.title}</h3>
              {section.paragraphs.map((paragraph) => (
                <p class="mt-2 text-sm leading-relaxed text-claro/70">{paragraph}</p>
              ))}
            </section>
          ))}
        </div>
      </div>
    ))}
  </div>
</dialog>

<style>
  #legal-dialog::backdrop {
    background: rgb(0 0 0 / 0.8);
    backdrop-filter: blur(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    #legal-dialog {
      transition: none !important;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#legal-dialog");
  const scrollBox = document.getElementById("legal-scroll");
  const titleEl = document.getElementById("legal-dialog-title");
  const updatedEl = document.getElementById("legal-dialog-updated");
  const blocks = {
    privacy: document.querySelector<HTMLElement>('[data-legal-block="privacy"]'),
    terms: document.querySelector<HTMLElement>('[data-legal-block="terms"]'),
  };

  function openLegal(id: "privacy" | "terms") {
    if (!dialog || !titleEl || !updatedEl) return;
    if (dialog.open) return;

    const block = blocks[id];
    if (!block) return;

    if (blocks.privacy) blocks.privacy.hidden = id !== "privacy";
    if (blocks.terms) blocks.terms.hidden = id !== "terms";
    titleEl.textContent = block.dataset.title || "";
    updatedEl.textContent = block.dataset.updated
      ? `Última actualización: ${block.dataset.updated}`
      : "";

    dialog.showModal();
    document.documentElement.style.overflow = "hidden";
    if (scrollBox) scrollBox.scrollTop = 0;
  }

  document.querySelectorAll<HTMLElement>("[data-legal]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const id = trigger.dataset.legal;
      if (id === "privacy" || id === "terms") openLegal(id);
    });
  });

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });

  dialog?.addEventListener("close", () => {
    document.documentElement.style.overflow = "";
  });
</script>
